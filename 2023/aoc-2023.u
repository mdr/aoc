      |> countValidArrangementsBetter)
      === 10)

day12.countValidArrangementsBetter' : [Nat] -> [SpringCondition] -> Nat
day12.countValidArrangementsBetter' checksum springConditions =
  match checksum with
    [] -> if List.contains Damaged springConditions then 0 else 1
    n +: checksumRest ->
      match springConditions with
        [] -> 0
        Operational +: conditionsRest ->
          day12.countValidArrangementsBetter' checksum conditionsRest
        Unknown +: conditionsRest ->
          day12.countValidArrangementsBetter'
            checksum (Operational List.+: conditionsRest)
            Nat.+ day12.countValidArrangementsBetter'
              checksum (Damaged List.+: conditionsRest)
        Damaged +: _ ->
          (damaged, conditionsRest) = List.splitAt n springConditions
          if List.size damaged Nat.== n && List.all isDamagedOrUnknown damaged
            && (conditionsRest |> List.head) !== Some Damaged then
            newConditionsRest = modifyHead (_ -> Operational) conditionsRest
            day12.countValidArrangementsBetter' checksumRest newConditionsRest
          else 0

day12.countValidArrangementsMemoised : SpringConditionRecord -> Nat
day12.countValidArrangementsMemoised = cases
  SpringConditionRecord springConditions checksum ->
    withInitialValue Map.empty do
      countValidArrangementsMemoised' checksum springConditions

day12.countValidArrangementsMemoised' :
  [Nat] -> [SpringCondition] ->{Store (Map ([Nat], [SpringCondition]) Nat)} Nat
day12.countValidArrangementsMemoised' checksum springConditions = 
  getOrUpdate (checksum, springConditions) do
    match checksum with
      [] -> if List.contains Damaged springConditions then 0 else 1
      n +: checksumRest ->
        match springConditions with
          [] -> 0
          Operational +: conditionsRest ->
            day12.countValidArrangementsMemoised' checksum conditionsRest
          Unknown +: conditionsRest ->
            day12.countValidArrangementsMemoised'
              checksum (Operational List.+: conditionsRest)
              Nat.+ day12.countValidArrangementsMemoised'
                checksum (Damaged List.+: conditionsRest)
          Damaged +: _ ->
            (damaged, conditionsRest) = List.splitAt n springConditions
            if List.size damaged Nat.== n
              && List.all isDamagedOrUnknown damaged
              && (conditionsRest |> List.head) !== Some Damaged then
              newConditionsRest = modifyHead (_ -> Operational) conditionsRest
              day12.countValidArrangementsMemoised'
                checksumRest newConditionsRest
            else 0

day12.eachValidArrangement : SpringConditionRecord ->{Each} [SpringCondition]
day12.eachValidArrangement = cases
  SpringConditionRecord springConditions checksum ->
    eachValidArrangement' checksum springConditions
      |> Each.filter (conditions -> calculateChecksum conditions === checksum)

day12.eachValidArrangement' :
  [Nat] -> [SpringCondition] ->{Each} [SpringCondition]
day12.eachValidArrangement' checksum springConditions =
  combine : [SpringCondition] -> SpringCondition -> [SpringCondition]
  combine decidedConditionsSoFar condition =
    decidedCondition = each (conditionOptions condition)
    decidedConditionsSoFar :+ decidedCondition
      |> Each.filter (isCompatibleWithChecksum checksum)
  List.foldLeft combine [] springConditions

day12.eachValidArrangementBetter :
  SpringConditionRecord ->{Each} [SpringCondition]
day12.eachValidArrangementBetter = cases
  SpringConditionRecord springConditions checksum ->
    eachValidArrangementBetter' checksum springConditions

day12.eachValidArrangementBetter' :
  [Nat] -> [SpringCondition] ->{Each} [SpringCondition]
day12.eachValidArrangementBetter' checksum springConditions =
  match checksum with
    [] ->
      springConditions
        |> filterNot (List.contains Damaged)
        |> List.map (_ -> Operational)
    n +: checksumRest ->
      match springConditions with
        [] -> Each.fail()
        Operational +: conditionsRest ->
          Operational
            List.+: day12.eachValidArrangementBetter' checksum conditionsRest
        Unknown +: conditionsRest ->
          day12.eachValidArrangementBetter'
            checksum (each [Operational, Damaged] List.+: conditionsRest)
        Damaged +: _ ->
          (damaged, conditionsRest) = List.splitAt n springConditions
          use List ++
          use Nat ==
          guard (List.size damaged == n)
          guard (List.all isDamagedOrUnknown damaged)
          guard ((conditionsRest |> List.head) !== Some Damaged)
          newConditionsRest = modifyHead (_ -> Operational) conditionsRest
          decidedDamaged = damaged |> List.map (_ -> Damaged)
          decidedDamaged
            ++ day12.eachValidArrangementBetter' checksumRest newConditionsRest

test> day12.eachValidArrangementBetter'.tests.emptyChecksum1 =
  check
    ((Each.toList do
      eachValidArrangementBetter' [] [Operational, Unknown, Operational])
      === [[Operational, Operational, Operational]])

test> day12.eachValidArrangementBetter'.tests.emptyChecksum2 =
  check
    ((Each.toList do
      eachValidArrangementBetter' [] [Operational, Unknown, Damaged])
      === [])

test> day12.eachValidArrangementBetter'.tests.emptyConditions =
  check ((Each.toList do eachValidArrangementBetter' [1, 1, 3] []) === [])

day12.findValidArrangements : SpringConditionRecord -> [[SpringCondition]]
day12.findValidArrangements conditionRecord = 
  Each.toList do eachValidArrangementBetter conditionRecord

test> day12.findValidArrangements.tests.example2Line1 =
  check
    ((day12.parser.parsePuzzleInput day12.inputs.example2
      |> List.at 0
      |> getOrBug "Bug"
      |> findValidArrangements)
      === [ [ Damaged
        , Operational
        , Damaged
        , Operational
        , Damaged
        , Damaged
        , Damaged
        ]
      ])

test> day12.findValidArrangements.tests.example2Line2 =
  check
    ((day12.parser.parsePuzzleInput day12.inputs.example2
      |> List.at 1
      |> getOrBug "Bug"
      |> findValidArrangements
      |> List.size)
      === 4)

test> day12.findValidArrangements.tests.example2Line3 =
  check
    ((day12.parser.parsePuzzleInput day12.inputs.example2
      |> List.at 2
      |> getOrBug "Bug"
      |> findValidArrangements
      |> List.size)
      === 1)

