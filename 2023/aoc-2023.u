day04.parser.numberMaybeWhitespace : '{Parse e} Nat
day04.parser.numberMaybeWhitespace = do
  n = numeric()
  _ = optional! skipWhitespace
  n

day04.parser.parseCard : Text -> day04.Card
day04.parser.parseCard text = match Parse.run day04.parser.card text with
  Either.Left _     -> bug "Could not parse card"
  Either.Right card -> card

day04.processCard : Bag Nat -> day04.Card -> Bag Nat
day04.processCard cardCounts card =
  winningNumbersCount = countWinningNumbers card
  cardNumber = Card.cardNumber card
  numberOfCopiesOfCard = Bag.count cardNumber cardCounts
  copyCardNumbers =
    Nat.range
      (cardNumber Nat.+ 1) (cardNumber Nat.+ winningNumbersCount Nat.+ 1)
  copyCardNumbers
    |> List.map (number -> (number, numberOfCopiesOfCard))
    |> Bag.fromOccurrenceList
    |> (Bag.+) cardCounts

day04.puzzle.input : Text
