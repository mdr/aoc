day11.puzzle.solutionPart1 : Nat
day11.puzzle.solutionPart1 = day11.solvePart1 day11.inputs.puzzle

day11.solvePart1 : Text -> Nat
day11.solvePart1 =
  textToCharArray2D
    >> expandUniverse
    >> findGalaxies
    >> allPairs
    >> Nat.sumBy (uncurry manhattenDistance)

test> day11.solvePart1.tests.example1 =
  check (day11.solvePart1 day11.inputs.example1 === 374)

test> day11.solvePart1.tests.puzzle =
  check (day11.solvePart1 day11.inputs.puzzle === 10289334)

day11.solvePart2 : Text -> Nat
day11.solvePart2 = solveWithExpansionFactor 1000000

test> day11.solvePart2.tests.puzzle =
  check (day11.solvePart2 day11.inputs.puzzle === 649862989626)

day11.solveWithExpansionFactor : Nat -> Text -> Nat
day11.solveWithExpansionFactor expansionFactor text =
  chars = text |> textToCharArray2D
  emptyYs = chars |> emptyGalaxyRowIndices
  emptyXs = chars |> transpose |> emptyGalaxyRowIndices
  galaxyPoints =
    findGalaxies chars
      |> List.map (updateGalaxyCoordinates emptyXs emptyYs expansionFactor)
  galaxyPoints |> allPairs |> Nat.sumBy (uncurry manhattenDistance)

test> day11.solveWithExpansionFactor.tests.example1 =
  check (solveWithExpansionFactor 2 day11.inputs.example1 === 374)

test> day11.solveWithExpansionFactor.tests.example1Times10 =
  check (solveWithExpansionFactor 10 day11.inputs.example1 === 1030)

test> day11.solveWithExpansionFactor.tests.example1Times100 =
  check (solveWithExpansionFactor 100 day11.inputs.example1 === 8410)

day11.updateGalaxyCoordinates : NatSet -> NatSet -> Nat -> Point -> Point
day11.updateGalaxyCoordinates emptyXs emptyYs expansionFactor point =
  use Nat * -
  use NatSet size split
  (Point x y) = point
  (smallerXs, _) = split x emptyXs
  (smallerYs, _) = split y emptyYs
  extraCopies = expansionFactor - 1
  extraSpaceX = size smallerXs * extraCopies
  extraSpaceY = size smallerYs * extraCopies
  point |> moveRight extraSpaceX |> moveDown extraSpaceY

day12.areChecksumsCompatible : [Nat] -> [Nat] -> Boolean
day12.areChecksumsCompatible prefix checksum = match (prefix, checksum) with
  ([], _)            -> true
  ([p], c +: cs)     -> p Nat.<= c
  (p +: ps, c +: cs) -> p === c && day12.areChecksumsCompatible ps cs
  _                  -> false

test> day12.areChecksumsCompatible.tests.case1 =
  check (areChecksumsCompatible [1, 1, 3] [1, 1, 3] === true)

test> day12.areChecksumsCompatible.tests.case2 =
  check (areChecksumsCompatible [1, 1, 3] [1, 1, 4] === true)

test> day12.areChecksumsCompatible.tests.case3 =
  check (areChecksumsCompatible [1, 1] [1, 1, 4] === true)

test> day12.areChecksumsCompatible.tests.case4 =
  check (areChecksumsCompatible [1, 1] [1, 3, 1, 6] === true)

test> day12.areChecksumsCompatible.tests.case5 =
  check (areChecksumsCompatible [2] [1, 3, 1, 6] === false)

day12.calculateChecksum : [SpringCondition] -> [Nat]
day12.calculateChecksum = cases
  []              -> []
  Damaged +: rest ->
    (otherDamaged, rest') = List.span (c -> c === Damaged) rest
    use List +:
    allDamaged = Damaged +: otherDamaged
    List.size allDamaged +: day12.calculateChecksum rest'
  _ +: rest       -> day12.calculateChecksum rest

test> day12.calculateChecksum.tests.example1Line1 =
  check
    ((utils.parseOrBug springConditionRecord "#.#.### 1,1,3"
      |> SpringConditionRecord.springs
      |> calculateChecksum)
      === [1, 1, 3])

day12.conditionOptions : SpringCondition -> [SpringCondition]
day12.conditionOptions = cases
  Operational -> [Operational]
  Damaged     -> [Damaged]
  Unknown     -> [Operational, Damaged]

day12.countValidArrangements : SpringConditionRecord -> Nat
day12.countValidArrangements conditionRecord = 
  Each.count do eachValidArrangementBetter conditionRecord

day12.countValidArrangementsBetter : SpringConditionRecord -> Nat
day12.countValidArrangementsBetter = cases
  SpringConditionRecord springConditions checksum ->
    countValidArrangementsBetter' checksum springConditions

test> day12.countValidArrangementsBetter.tests.example2Line1 =
  check
    ((parseSpringConditionRecord "???.### 1,1,3"
      |> countValidArrangementsBetter)
      === 1)

test> day12.countValidArrangementsBetter.tests.example2Line2 =
  check
    ((parseSpringConditionRecord ".??..??...?##. 1,1,3"
      |> countValidArrangementsBetter)
      === 4)

test> day12.countValidArrangementsBetter.tests.example2Line3 =
