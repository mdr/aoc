day01.digitWords : [(Text, Nat)]
day01.digitWords =
  [ ("zero", 0)
  , ("one", 1)
  , ("two", 2)
  , ("three", 3)
  , ("four", 4)
  , ("five", 5)
  , ("six", 6)
  , ("seven", 7)
  , ("eight", 8)
  , ("nine", 9)
  ]

day01.examplePart1 : [Text]
day01.examplePart1 = ["1abc2", "pqr3stu8vwx", "a1b2c3d4e5f", "treb7uchet"]

day01.extractDigits : [(Text, Nat)] -> Text -> [Nat]
day01.extractDigits digitWords text =
  match Text.uncons text with
    Some (firstCharacter, rest) ->
      if isDigit firstCharacter then
        firstCharacter
          |> Char.toText
          |> Nat.fromText
          |> getOrBug "Could not parse digit"
          List.+: day01.extractDigits digitWords rest
      else
        match tryParseDigitWord digitWords text with
          None -> day01.extractDigits digitWords rest
          Some (digit, rest) ->
            digit List.+: day01.extractDigits digitWords rest
    None -> []

test> day01.extractDigits.tests.empty =
  check (extractDigits digitWords "" === [])

test> day01.extractDigits.tests.singleCharacterDigits =
  check (extractDigits digitWords "1abc2" === [1, 2])

test> day01.extractDigits.tests.test83 =
  check (extractDigits digitWords "eighthree" === [8])

test> day01.extractDigits.tests.test83Backwards =
  check (extractDigits reverseDigitWords (Text.reverse "eighthree") === [3])

test> day01.extractDigits.tests.wordDigits =
  check (extractDigits digitWords "two1nine" === [2, 1, 9])

test> day01.extractDigits.tests.wordDigits2 =
  check (extractDigits digitWords "7pqrstsixteen" === [7, 6])

day01.getCalibrationValue : Text -> Nat
day01.getCalibrationValue text =
  use Text ++
  digits = toCharList text |> List.filter isDigit |> List.map Char.toText
  firstDigit = List.head digits |> getOrBug "No first digit found"
  lastDigit = List.last digits |> getOrBug "No last digit found"
  firstDigit ++ lastDigit
    |> Nat.fromText
    |> getOrBug "Could not parse calibration value"

test> day01.getCalibrationValue.tests.multipleDigits =
  use Nat ==
  check (getCalibrationValue "a1s2df" == 12)

test> day01.getCalibrationValue.tests.singleDigit =
  use Nat ==
  check (getCalibrationValue "treb7uchet" == 77)

day01.getCalibrationValue2 : Text -> Nat
day01.getCalibrationValue2 text =
  use List head
  use Nat toText
  use Text ++
  digitsForwards = extractDigits digitWords text
  digitsBackwards = extractDigits reverseDigitWords (Text.reverse text)
  firstDigit = head digitsForwards |> getOrBug "No first digit found"
  lastDigit = head digitsBackwards |> getOrBug "No last digit found"
  firstDigit |> toText ++ (lastDigit |> toText)
    |> Nat.fromText
    |> getOrBug "Could not parse calibration value"

test> day01.getCalibrationValue2.tests.example1 =
  check (getCalibrationValue2 "abcone2threexyz" === 13)

test> day01.getCalibrationValue2.tests.example2 =
  check (getCalibrationValue2 "zoneight234" === 14)

test> day01.getCalibrationValue2.tests.example3 =
  check (getCalibrationValue2 "42" === 42)

test> day01.getCalibrationValue2.tests.example4 =
  check (getCalibrationValue2 "6onesix" === 66)

test> day01.getCalibrationValue2.tests.example5 =
  check (getCalibrationValue2 "eighthree" === 83)

test> day01.getCalibrationValue2.tests.example6 =
  check (getCalibrationValue2 "sevenine" === 79)

day01.reverseDigitWords : [(Text, Nat)]
day01.reverseDigitWords = digitWords |> List.map revWord

day01.revWord : (Text, Nat) -> (Text, Nat)
day01.revWord = cases (word, digit) -> (Text.reverse word, digit)

day01.run : '{IO, Exception} ()
day01.run = do
  use Nat toText
  use Text ++
  text = readFileUtf8 (FilePath "inputs/day-01.txt")
  answer1 = day01.solvePart1 text
  answer2 = day01.solvePart2 text
  printLine ("Answer to part 1: " ++ toText answer1)
  printLine ("Answer to part 2: " ++ toText answer2)

day01.solvePart1 : Text -> Nat
day01.solvePart1 = lines >> Nat.sumBy getCalibrationValue

test> day01.solvePart1.tests.example =
  use Nat ==
  example =
    """
      1abc2
      pqr3stu8vwx
      a1b2c3d4e5f
      treb7uchet
    """
  check (day01.solvePart1 example == 142)

day01.solvePart2 : Text -> Nat
day01.solvePart2 = lines >> Nat.sumBy getCalibrationValue2

test> day01.solvePart2.tests.example =
  use Nat ==
  example =
    """
      two1nine
      eightwothree
      abcone2threexyz
      xtwone3four
      4nineeightseven2
      zoneight234 
      7pqrstsixteen
    """
  check (day01.solvePart2 example == 281)

day01.tryParseDigitWord : [(Text, Nat)] -> Text -> Optional (Nat, Text)
day01.tryParseDigitWord digitWords text =
  match digitWords with
    [] -> None
    (digitWord, digit) +: rest ->
      if startsWith digitWord text then
        Some (digit, Text.drop (Text.size digitWord) text)
      else day01.tryParseDigitWord rest text

test> day01.tryParseDigitWord.tests.empty =
  check (tryParseDigitWord digitWords "" === None)

day02.elfBag : Bag Colour
day02.elfBag =
  use Bag addN
  Bag.empty
    |> addN 12 Colour.Red
    |> addN 13 Colour.Green
    |> addN 14 Colour.Blue

day02.isGamePossible : Game -> Boolean
day02.isGamePossible game = List.all isRevealPossible (Game.reveals game)

day02.isRevealPossible : Bag Colour -> Boolean
day02.isRevealPossible bag = Bag.subbag bag elfBag

day02.makeColourBag : Nat -> Nat -> Nat -> Bag Colour
day02.makeColourBag red green blue =
  use Bag addN
  Bag.empty
    |> addN red Colour.Red
    |> addN green Colour.Green
    |> addN blue Colour.Blue

day02.parser.bagSegment : '{Parse e} Bag Colour
day02.parser.bagSegment = do
  n = numeric()
  skipWhitespace()
  colour = parser.colour()
  bagOfN n colour

test> day02.parser.bagSegment.tests.example1 =
  check
    (Parse.run bagSegment "12 red"
      === Either.Right (Bag.empty |> Bag.addN 12 Colour.Red))

day02.parser.blue : '{Parse e} Colour
day02.parser.blue = specificColour "blue" Colour.Blue

day02.parser.colour : '{Parse e} Colour
day02.parser.colour = ors (parser.red +| [parser.green, parser.blue])

test> day02.parser.colour.tests.blue =
  check (Parse.run parser.colour "blue" === Either.Right Colour.Blue)

test> day02.parser.colour.tests.green =
  check (Parse.run parser.colour "green" === Either.Right Colour.Green)

test> day02.parser.colour.tests.red =
  check (Parse.run parser.colour "red" === Either.Right Colour.Red)

day02.parser.game : '{Parse e} Game
day02.parser.game = do
  text! "Game "
  id = numeric()
  text! ": "
  bags = parser.reveals()
  Game id bags

