day20.investigatePeriodicity : ModuleName -> Nat -> [Nat]
day20.investigatePeriodicity moduleName iterations =
  use List map
  use Nat + >
  day20.inputs.puzzle
    |> parseAndInitialise
    |> (network ->
         toList! do
           withInitialValue zeros do
             iterateWithStoreHistory iterations pressButton network)
    |> map (countPulses moduleName)
    |> slidingDiff2Pairwise
    |> List.indexed
    |> map (Tuple.mapRight (n -> n + 1))
    |> (List.filter cases ((h, l), n) -> l > 0)
    |> map at2

day20.iterateWithStoreHistory :
  Nat -> (a ->{Store s} a) -> a ->{Store s, Stream s} a
day20.iterateWithStoreHistory n f a =
  use Nat -
  Store.get |> emit
  if n === 0 then a else day20.iterateWithStoreHistory (n - 1) f (f a)

day20.Module.name : Module -> ModuleName
day20.Module.name = cases
  Broadcast _          -> ModuleName "broadcaster"
  FlipFlop name _ _    -> name
  Conjunction name _ _ -> name
  Module.Untyped name  -> name

day20.Module.outputModules : Module -> [ModuleName]
day20.Module.outputModules = cases
  Broadcast destinations       -> destinations
  FlipFlop _ _ destinations    -> destinations
  Conjunction _ _ destinations -> destinations
  Module.Untyped _             -> []

day20.ModuleName.broadcaster : ModuleName
day20.ModuleName.broadcaster = ModuleName "broadcaster"

day20.ModuleName.button : ModuleName
day20.ModuleName.button = ModuleName "button"

day20.ModuleNetwork.connectivity : ModuleNetwork -> Map ModuleName [ModuleName]
day20.ModuleNetwork.connectivity = cases
  ModuleNetwork modules ->
    modules
      |> Map.values
      |> List.map (module -> (Module.name module, outputModules module))
      |> Map.fromList

day20.ModuleNetwork.getModule : ModuleName -> ModuleNetwork -> Module
day20.ModuleNetwork.getModule name network =
  use Text ++
  network
    |> modules
    |> Map.get name
    |> getOrBug ("invalid module name: " ++ (name |> ModuleName.toText))

day20.ModuleNetwork.updateModule :
  ModuleName -> Module -> ModuleNetwork -> ModuleNetwork
day20.ModuleNetwork.updateModule name module = cases
  ModuleNetwork modules -> ModuleNetwork (Map.insert name module modules)

day20.ModuleState.storePulseIncrement :
  ModuleName -> Pulse ->{Store ModuleState} ()
day20.ModuleState.storePulseIncrement moduleName pulse =
  Store.modify (pulseCounts.modify (PulseCounts.increment moduleName pulse))

day20.ModuleState.storeReplaceModule :
  ModuleName -> Module ->{Store ModuleState} ()
day20.ModuleState.storeReplaceModule name module =
  Store.modify (network.modify (updateModule name module))

day20.OnOrOff.flip : OnOrOff -> OnOrOff
day20.OnOrOff.flip = cases
  On  -> Off
  Off -> On

day20.parseAndInitialise : Text -> ModuleNetwork
day20.parseAndInitialise =
  parseModuleNetwork >> addUntypedModules >> initialiseConjunction

day20.parser.broadcast : '{Parse e} Module
day20.parser.broadcast = do
  text! "broadcaster"
  skipWhitespace()
  destinations = parser.destinations()
  Broadcast destinations

day20.parser.conjunction : '{Parse e} Module
day20.parser.conjunction = do
  text! "&"
  name = moduleName()
  skipWhitespace()
  destinations = parser.destinations()
  Conjunction name Map.empty destinations

day20.parser.destinations : '{Parse e} [ModuleName]
day20.parser.destinations = do
  text! "->"
  skipWhitespace()
  sep1! (Parse.text ", ") moduleName

test> day20.parser.destinations.tests.multiple =
  check
    (utils.parseOrBug destinations "-> a, b, c"
      === [ModuleName "a", ModuleName "b", ModuleName "c"])

test> day20.parser.destinations.tests.single =
  check (utils.parseOrBug destinations "-> a" === [ModuleName "a"])

day20.parser.flipFlop : '{Parse e} Module
day20.parser.flipFlop = do
  text! "%"
  name = moduleName()
  skipWhitespace()
  destinations = parser.destinations()
  FlipFlop name Off destinations

day20.parser.module : '{Parse e} Module
day20.parser.module =
  ors (parser.broadcast +| [parser.flipFlop, parser.conjunction])

test> day20.parser.module.tests.broadcast =
  check
    (utils.parseOrBug module "broadcaster -> a, b, c"
      === Broadcast [ModuleName "a", ModuleName "b", ModuleName "c"])

test> day20.parser.module.tests.conjunction =
  check
    (utils.parseOrBug module "&a -> b, c"
      === Conjunction
        (ModuleName "a") Map.empty [ModuleName "b", ModuleName "c"])

test> day20.parser.module.tests.flipFlop =
  check
    (utils.parseOrBug module "%a -> b, c"
      === FlipFlop (ModuleName "a") Off [ModuleName "b", ModuleName "c"])

day20.parser.moduleName : '{Parse e} ModuleName
day20.parser.moduleName = do takeAlphanum1() |> ModuleName

day20.parser.parseModuleNetwork : Text -> ModuleNetwork
day20.parser.parseModuleNetwork text =
  text
    |> lines
    |> List.map (utils.parseOrBug module)
    |> indexBy Module.name
    |> ModuleNetwork

test> day20.parser.parseModuleNetwork.tests.example1 =
  use Nat ==
  check
    ((day20.inputs.example1 |> parseModuleNetwork |> modules |> Map.size) == 5)

day20.periodicModuleNames : [ModuleName]
day20.periodicModuleNames = ["lz", "tg", "hn", "kh"] |> List.map ModuleName

day20.pressButton : ModuleNetwork ->{Store PulseCounts} ModuleNetwork
day20.pressButton network =
  pulseQueue = [PulseTransmission button Low broadcaster]
  startState = ModuleState network zeros
  finishState = 
    withInitialValueReturningStore startState do processPulses pulseQueue
  (ModuleState updatedNetwork pulseCounts) = finishState
  Store.modify (PulseCounts.add pulseCounts)
  updatedNetwork

day20.processPulse :
  PulseTransmission ->{Store ModuleState} [PulseTransmission]
day20.processPulse = cases
  PulseTransmission from pulse to ->
    use List map
    storePulseIncrement to pulse
    (ModuleState network pulseCounts) = Store.get
    destinationModule = getModule to network
    match destinationModule with
      Module.Untyped _ -> []
      Broadcast destinations ->
        destinations
          |> map (destination -> PulseTransmission to pulse destination)
      FlipFlop name onOrOff destinations ->
        match pulse with
          High -> []
          Low ->
            newOnOrOff = OnOrOff.flip onOrOff
            newPulse = if newOnOrOff === On then High else Low
            updatedModule = FlipFlop name newOnOrOff destinations
            storeReplaceModule name updatedModule
            destinations
              |> map (destination -> PulseTransmission to newPulse destination)
      Conjunction name mostRecentPulses destinations ->
        newMostRecentPulses = mostRecentPulses |> Map.insert from pulse
        updatedModule = Conjunction name newMostRecentPulses destinations
        storeReplaceModule name updatedModule
        allHigh =
          newMostRecentPulses
            |> Map.values
            |> List.all (pulse -> pulse === High)
        outputPulse = if allHigh then Low else High
        destinations
          |> map (destination -> PulseTransmission to outputPulse destination)

day20.processPulses : [PulseTransmission] ->{Store ModuleState} ()
day20.processPulses = cases
  []            -> ()
  pulse +: rest ->
    use List ++
    newPulses = processPulse pulse
    day20.processPulses (rest ++ newPulses)

day20.PulseCounts.add : PulseCounts -> PulseCounts -> PulseCounts
day20.PulseCounts.add = cases
  PulseCounts high1 low1 ->
    cases
      PulseCounts high2 low2 ->
        PulseCounts (high1 Bag.+ high2) (low1 Bag.+ low2)

day20.PulseCounts.countHighPulses : ModuleName -> PulseCounts -> Nat
day20.PulseCounts.countHighPulses name = cases
  PulseCounts high low -> Bag.count name high

day20.PulseCounts.countPulses : ModuleName -> PulseCounts -> (Nat, Nat)
day20.PulseCounts.countPulses name = cases
  PulseCounts high low -> (Bag.count name high, Bag.count name low)

day20.PulseCounts.increment : ModuleName -> Pulse -> PulseCounts -> PulseCounts
day20.PulseCounts.increment moduleName pulse = cases
  PulseCounts high low ->
    match pulse with
      High -> PulseCounts (Bag.add moduleName high) low
      Low  -> PulseCounts high (Bag.add moduleName low)

day20.PulseCounts.score : PulseCounts -> Nat
day20.PulseCounts.score = cases
  PulseCounts high low -> Bag.size high Nat.* Bag.size low

day20.PulseCounts.zeros : PulseCounts
day20.PulseCounts.zeros =
  use Bag empty
  PulseCounts empty empty

