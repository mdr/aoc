day12.isCompatibleWithChecksum : [Nat] -> [SpringCondition] -> Boolean
day12.isCompatibleWithChecksum checksum conditions =
  areChecksumsCompatible (calculateChecksum conditions) checksum

day12.parser.checksum : '{Parse e} [Nat]
day12.parser.checksum = sep1 (Parse.text ",") numeric

day12.parser.parsePuzzleInput : Text -> [SpringConditionRecord]
day12.parser.parsePuzzleInput =
  lines >> List.map (utils.parseOrBug springConditionRecord)

test> day12.parser.parsePuzzleInput.tests.example1 =
  use Nat ==
  check
    ((day12.parser.parsePuzzleInput day12.inputs.example1 |> List.size) == 6)

day12.parser.parseSpringConditionRecord : Text -> SpringConditionRecord
day12.parser.parseSpringConditionRecord =
  utils.parseOrBug springConditionRecord

day12.parser.springCondition : '{Parse e} SpringCondition
day12.parser.springCondition =
  use Parse text
  operational = text "." $> Operational
  damaged = text "#" $> Damaged
  unknown = text "?" $> Unknown
  ors (operational +| [damaged, unknown])

day12.parser.springConditionRecord : '{Parse e} SpringConditionRecord
day12.parser.springConditionRecord = do
  springs = parser.springs()
  skipWhitespace()
  checksum = parser.checksum()
  SpringConditionRecord springs checksum

test> day12.parser.springConditionRecord.tests.example2Line1 =
  check
    (utils.parseOrBug springConditionRecord "???.### 1,1,3"
      === SpringConditionRecord
        [Unknown, Unknown, Unknown, Operational, Damaged, Damaged, Damaged]
        [1, 1, 3])

day12.parser.springs : '{Parse e} [SpringCondition]
day12.parser.springs = Parse.many springCondition

day12.puzzle.solutionPart1 : Nat
day12.puzzle.solutionPart1 = day12.solvePart1 day12.inputs.puzzle

day12.puzzle.solutionPart2 : Nat
day12.puzzle.solutionPart2 = day12.solvePart2 day12.inputs.puzzle

test> day12.solvePart.tests.example2 =
  check (day12.solvePart2 day12.inputs.example2 === 525152)

day12.solvePart1 : Text -> Nat
day12.solvePart1 =
  day12.parser.parsePuzzleInput >> Nat.sumBy countValidArrangementsMemoised

test> day12.solvePart1.tests.example2 =
  check (day12.solvePart1 day12.inputs.example2 === 21)

test> day12.solvePart1.tests.puzzle =
  check (day12.solvePart1 day12.inputs.puzzle === 7674)

day12.solvePart2 : Text -> Nat
day12.solvePart2 =
  day12.parser.parsePuzzleInput
    >> List.map unfoldRecord
    >> Nat.sumBy countValidArrangementsMemoised

day12.SpringCondition.isDamagedOrUnknown : SpringCondition -> Boolean
day12.SpringCondition.isDamagedOrUnknown = cases
  Operational -> false
  Damaged     -> true
  Unknown     -> true

day12.SpringCondition.toText : SpringCondition -> Text
day12.SpringCondition.toText = cases
  Operational -> "."
  Damaged     -> "#"
  Unknown     -> "?"

day12.SpringConditionRecord.toText : SpringConditionRecord -> Text
day12.SpringConditionRecord.toText = cases
  SpringConditionRecord springConditions checksum ->
    springConditionsToText springConditions
      Text.++ " "
      Text.++ (checksum |> List.map Nat.toText |> Text.join ",")

day12.springConditionsToText : [SpringCondition] -> Text
day12.springConditionsToText = List.map SpringCondition.toText >> Text.join ""

day12.unfoldRecord : SpringConditionRecord -> SpringConditionRecord
day12.unfoldRecord = cases
  SpringConditionRecord springConditions checksum ->
    use List fill
    newSpringConditions = springConditions |> fill 5 |> intercalate [Unknown]
    newChecksum = checksum |> fill 5 |> List.join
    SpringConditionRecord newSpringConditions newChecksum

test> day12.unfoldRecord.tests.example2Line1 =
  check
    ((unfoldRecord (utils.parseOrBug springConditionRecord "???.### 1,1,3")
      |> SpringConditionRecord.toText)
      === "???.###????.###????.###????.###????.### 1,1,3,1,1,3,1,1,3,1,1,3,1,1,3")

day12.verifyChecksum : SpringConditionRecord -> Boolean
day12.verifyChecksum = cases
  SpringConditionRecord springs checksum ->
    calculateChecksum springs === checksum

test> day12.verifyChecksum.tests.example1 =
  check
    (day12.parser.parsePuzzleInput day12.inputs.example1
      |> List.all verifyChecksum)

day13.axisMultiplier : Axis -> Nat
day13.axisMultiplier = cases
  Horizontal -> 100
  Vertical   -> 1

day13.findLineOfReflection : TerrainPattern -> Optional Nat
day13.findLineOfReflection pattern =
  rows = pattern |> TerrainPattern.rows
  Nat.range 1 (List.size rows) |> List.find (n -> isLineOfReflection n rows)

test> day13.findLineOfReflection.tests.example1Pattern1 =
  check
    ((day13.parser.parsePuzzleInput day13.inputs.example1
      |> List.at 1
      |> getOrBug "bug"
      |> findLineOfReflection)
      === Some 4)

day13.findNewReflectionLinesAfterSmudge :
  TerrainPattern -> Point -> Set ReflectionLine
day13.findNewReflectionLinesAfterSmudge pattern point =
  smudged = smudgeAt point pattern
  newReflectionLines = findReflectionLines smudged
  originalReflectionLines = findReflectionLines pattern
  Set.difference newReflectionLines originalReflectionLines

day13.findReflectionLines : TerrainPattern -> Set ReflectionLine
day13.findReflectionLines pattern =
  horizontal = findReflectionLinesInAxis Horizontal pattern
  vertical = findReflectionLinesInAxis Vertical pattern
  Set.union horizontal vertical

day13.findReflectionLinesAfterSmudge : TerrainPattern -> Set ReflectionLine
day13.findReflectionLinesAfterSmudge pattern =
  pattern
    |> allPoints
    |> Set.fromList
    |> Set.flatMap (findNewReflectionLinesAfterSmudge pattern)

day13.findReflectionLinesInAxis : Axis -> TerrainPattern -> Set ReflectionLine
day13.findReflectionLinesInAxis axis pattern =
  rows =
    pattern
      |> TerrainPattern.rows
      |> (if axis === Horizontal then Function.id else transpose)
  Nat.range 1 (List.size rows)
    |> List.filter (n -> isLineOfReflection n rows)
    |> List.map (ReflectionLine axis)
    |> Set.fromList

test> day13.findSmudgePoint.tests.example1Pattern1 =
  check
    ((day13.parser.parsePuzzleInput day13.inputs.example1
      |> List.at 0
      |> getOrBug "bug"
      |> findReflectionLinesAfterSmudge)
      === Set.fromList [ReflectionLine Horizontal 3])

test> day13.findSmudgePoint.tests.example1Pattern2 =
  check
    ((day13.parser.parsePuzzleInput day13.inputs.example1
      |> List.at 1
      |> getOrBug "bug"
      |> findReflectionLinesAfterSmudge)
      === Set.fromList [ReflectionLine Horizontal 1])

