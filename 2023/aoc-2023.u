up.Each.count : '{g, Each} a ->{g} Nat
up.Each.count a =
  use Nat +
  step n _ = n + 1
  Each.toStream a |> fold! step 0

up.Each.failWhen : Boolean ->{Each} ()
up.Each.failWhen b = guard (Boolean.not b)

up.Each.filterNot : (a ->{e} Boolean) -> a ->{e, Each} a
up.Each.filterNot f = Each.filter (f >> Boolean.not)

up.Map.indexBy : (a ->{g} b) -> [a] ->{g} Map b a
up.Map.indexBy f = List.map (a -> (f a, a)) >> Map.fromList

utils.also : (a ->{g} ()) -> a ->{g} a
utils.also f x =
  f x
  x

utils.applyWithEmptyStore : (a ->{Store (Map c d)} b) -> a -> b
utils.applyWithEmptyStore f a = withInitialValue Map.empty do f a

utils.areaOfPolygon : [(Float, Float)] -> Float
utils.areaOfPolygon vertices =
  use Float * - /
  List.zip vertices (utils.rotateLeft vertices)
    |> (List.map cases ((x1, y1), (x2, y2)) -> x1 * y2 - x2 * y1)
    |> Float.sum
    |> Float.abs
    |> (n -> n / 2.0)

