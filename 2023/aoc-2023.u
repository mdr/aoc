day09.iterateDifferences : [Int] -> [[Int]]
day09.iterateDifferences = iterateUntil allZeros differences

test> day09.iterateDifferences.tests.example =
  check
    (iterateDifferences [+0, +3, +6, +9, +12, +15]
      === [[+0, +3, +6, +9, +12, +15], [+3, +3, +3, +3, +3], [+0, +0, +0, +0]])

day09.parser.parsePuzzleInput : Text -> [[Int]]
day09.parser.parsePuzzleInput =
  lines >> List.map (words >> List.filterMap Int.fromText)

test> day09.parser.parsePuzzleInput.tests.example =
  check
    (day09.parser.parsePuzzleInput inputs.example
      === [ [+0, +3, +6, +9, +12, +15]
      , [+1, +3, +6, +10, +15, +21]
      , [+10, +13, +16, +21, +30, +45]
      ])

day09.solvePart1 : Text -> Int
day09.solvePart1 =
  day09.parser.parsePuzzleInput >> Int.sumBy extrapolateHistory

test> day09.solvePart1.tests.example =
  check (day09.solvePart1 inputs.example === +114)

test> day09.solvePart1.tests.puzzle =
  check (day09.solvePart1 day09.inputs.puzzle === +1584748274)

day09.solvePart2 : Text -> Int
day09.solvePart2 =
  day09.parser.parsePuzzleInput >> Int.sumBy extrapolateHistoryBackwards

test> day09.solvePart2.tests.example1 =
  check (day09.solvePart2 inputs.example === +2)

test> day09.solvePart2.tests.puzzle =
  check (day09.solvePart2 day09.inputs.puzzle === +1026)

day10.fixStartConnections : PipeGraph -> PipeGraph
day10.fixStartConnections graph =
  use Multimap lookup
  (PipeGraph start connectionMap) = graph
  neighbours = lookup start connectionMap
  isValidNeighbour : Point -> Boolean
  isValidNeighbour neighbour =
    lookup neighbour connectionMap |> List.contains start
  newNeighbours = neighbours |> List.filter isValidNeighbour
  connectionMap.modify (Map.insert start newNeighbours) graph

test> day10.fixStartConnections.tests.example1 =
  check
    ((parsePipeGraph day10.inputs.example1
      |> fixStartConnections
      |> connectionMap
      |> Multimap.lookup (Point 1 1))
      === [Point 1 2, Point 2 1])

day10.getAllPoints : Nat -> Nat -> [Point]
day10.getAllPoints width height =
  use Nat - range
  xRange = range 0 (width - 1)
  yRange = range 0 (height - 1)
  xRange |> List.flatMap (x -> yRange |> List.map (y -> Point x y))

day10.getInnerPoints : Text -> Set Point -> [Point]
day10.getInnerPoints text loopPoints =
  text
    |> lines
    |> List.indexed
    |> (List.flatMap cases
         (line, lineNumber) ->
           getInnerPointsOnLineOLD line lineNumber loopPoints)

day10.getInnerPointsOnLine : Text -> [Nat]
day10.getInnerPointsOnLine line = toList! do handleLineScanner line scanLine

test> day10.getInnerPointsOnLine.tests.example3Line1 =
  check (getInnerPointsOnLine "           " === [])

test> day10.getInnerPointsOnLine.tests.example3Line2 =
  check (getInnerPointsOnLine " ┌───────┐ " === [])

test> day10.getInnerPointsOnLine.tests.example3Line3 =
  check (getInnerPointsOnLine " │┌─────┐│ " === [])

test> day10.getInnerPointsOnLine.tests.example3Line4 =
  check (getInnerPointsOnLine " ││     ││ " === [])

test> day10.getInnerPointsOnLine.tests.example3Line5 =
  check (getInnerPointsOnLine " │└─┐ ┌─┘│ " === [])

test> day10.getInnerPointsOnLine.tests.example3Line6 =
  check (getInnerPointsOnLine " │  │ │  │ " === [2, 3, 7, 8])

test> day10.getInnerPointsOnLine.tests.example3Line7 =
  check (getInnerPointsOnLine " └──┘ └──┘ " === [])

day10.getInnerPointsOnLineOLD : Text -> Nat -> Set Point -> [Point]
day10.getInnerPointsOnLineOLD line lineNumber loopPoints =
  use List ++
  isLoopPoint : Point -> Boolean
  isLoopPoint point = Set.contains point loopPoints
  go : Point -> Boolean -> [Char] -> [Point]
  go currentPoint isInsideLoop = cases
    [] -> []
    c +: cs ->
      nextPoint = Point.right currentPoint
      isCurrentPointLoop = isLoopPoint currentPoint
      if isCurrentPointLoop then
        nextIsInsideLoop =
          if c === ?| || c === ?L || c === ?F then Boolean.not isInsideLoop
          else isInsideLoop
        go nextPoint nextIsInsideLoop cs
      else
        (if isInsideLoop then [currentPoint] else [])
          ++ go nextPoint isInsideLoop cs
  go (Point 0 lineNumber) false (line |> toCharList)

day10.getLoop : PipeGraph -> [Point]
day10.getLoop = cases
  PipeGraph start connectionMap ->
    use Multimap lookup
    traverseLoop : Point -> Point -> [Point] -> [Point]
    traverseLoop previous current pointsSoFar =
      if current === start then pointsSoFar
      else
        neighbours =
          lookup current connectionMap
            |> List.filter (neighbour -> neighbour !== previous)
        match neighbours with
          [next] -> traverseLoop current next (pointsSoFar :+ current)
          []     -> bug "No neighbours"
          _      -> bug "Too many neighbours"
    startNeighbour =
      lookup start connectionMap
        |> List.head
        |> getOrBug "No neighbours for start"
    traverseLoop start startNeighbour [start]

test> day10.getLoop.tests.example1 =
  check
    ((parsePipeGraph day10.inputs.example1 |> fixStartConnections |> getLoop)
      === [ Point 1 1
      , Point 1 2
      , Point 1 3
      , Point 2 3
      , Point 3 3
      , Point 3 2
      , Point 3 1
      , Point 2 1
      ])

day10.getLoopLength : PipeGraph -> Nat
day10.getLoopLength = getLoop >> List.size

test> day10.getLoopLength.tests.example1 =
  check
    ((parsePipeGraph day10.inputs.example1
      |> fixStartConnections
      |> getLoopLength)
      === 8)

test> day10.getLoopLength.tests.example2 =
  check
    ((parsePipeGraph day10.inputs.example2
      |> fixStartConnections
      |> getLoopLength)
      === 16)

day10.getLoopPoints : Text -> Set Point
day10.getLoopPoints text =
  text |> parsePipeGraph |> fixStartConnections |> getLoop |> Set.fromList

day10.getStartCharacter : Point -> Set Point -> Map Point [Point] -> Char
day10.getStartCharacter point loopPoints connectionMap =
  use Point left right
  use Set fromList
  neighbours =
    Multimap.lookup point connectionMap
      |> List.filter (p -> Set.contains p loopPoints)
      |> fromList
  Debug.trace "xxx" (neighbours |> Set.toList)
  if neighbours === fromList [up point, down point] then ?│
  else
    if neighbours === fromList [left point, right point] then ?─
    else
      if neighbours === fromList [up point, right point] then ?└
      else
        if neighbours === fromList [up point, left point] then ?┘
        else
          if neighbours === fromList [down point, left point] then ?┐
          else
            if neighbours === fromList [down point, right point] then ?┌
            else
              if
                neighbours
                  === fromList [up point, down point, left point, right point] then
                ?┼
              else bug "Unexpected neighbours"

day10.handleLineScanner : Text -> '{g, LineScanner} () ->{g, Stream Nat} ()
day10.handleLineScanner line interactions =
  use Nat + -
  handler : [Char] -> Nat -> Boolean -> Request {LineScanner} () -> ()
  handler chars position isInLoop = cases
    { nextCharacter -> resume } ->
      match chars with
        []      -> ()
        c +: cs -> handle resume c with handler cs (position + 1) isInLoop
    { emitPosition -> resume } ->
      emit (position - 1)
      handle resume() with handler chars position isInLoop
    { isInsideLoop -> resume } ->
      handle resume isInLoop with handler chars position isInLoop
    { flipIsInsideLoop -> resume } ->
      handle resume() with handler chars position (Boolean.not isInLoop)
    { pure } -> ()
  handle interactions() with handler (toCharList line) 0 false

