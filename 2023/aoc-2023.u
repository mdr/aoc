day16.parser.parseTileMap : Text -> TileMap
day16.parser.parseTileMap text =
  charGrid = text |> textToCharArray2D
  tilesByPoint =
    charGrid |> gridToMap |> Map.mapKeys (moveRight 1 >> moveDown 1)
  (width, height) = gridWidthAndHeight charGrid
  bounds = Rectangle (Point 1 1) (Point width height)
  TileMap tilesByPoint bounds

day16.puzzle.timePart1 : '{IO, Exception} (Nat, Text)
day16.puzzle.timePart1 = 
  measureTimeTaken do day16.solvePart1 day16.inputs.puzzle

day16.puzzle.timePart2 : '{IO, Exception} (Nat, Text)
day16.puzzle.timePart2 = 
  measureTimeTaken do day16.solvePart2 day16.inputs.puzzle

day16.solvePart1 : Text -> Nat
day16.solvePart1 text =
  tileMap = parseTileMap text
  initialBeamState = BeamState (Point 1 1) utils.Direction.Right
  countEnergisedTiles tileMap initialBeamState

test> day16.solvePart1.tests.example1 =
  check (day16.solvePart1 day16.inputs.example1 === 46)

day16.solvePart2 : Text -> Nat
day16.solvePart2 text =
  tileMap = parseTileMap text
  initialBeamStates tileMap
    |> List.map (countEnergisedTiles tileMap)
    |> maximum
    |> getOrBug "no maximum"

test> day16.solvePart2.tests.example1 =
  check (day16.solvePart2 day16.inputs.example1 === 51)

day16.solvePart2PuzzleCloud : '{IO, Exception} (Nat, Text)
day16.solvePart2PuzzleCloud = 
  solveRemote true do day16.solvePart2 day16.inputs.puzzle

day16.solvePart2PuzzleLocal : '{IO, Exception} (Nat, Text)
day16.solvePart2PuzzleLocal = 
  solveRemote false do day16.solvePart2 day16.inputs.puzzle

day16.solvePart2Remote : Text -> '{Remote} Nat
day16.solvePart2Remote text =
  do
    tileMap = parseTileMap text
    initialBeamStates tileMap
      |> Remote.parMap (countEnergisedTiles tileMap)
      |> maximum
      |> getOrBug "no maximum"

day16.traceBeam : TileMap -> BeamState ->{Each, Store (Set BeamState)} ()
day16.traceBeam tileMap beamState =
  (BeamState enteringPoint direction) = beamState
  visitedStates = Store.get
  failWhen (Set.contains beamState visitedStates)
  tileCharacter = optionally (Map.get enteringPoint (tilesByPoint tileMap))
  Store.put (Set.insert beamState visitedStates)
  newBeamState = beamStep tileCharacter beamState
  day16.traceBeam tileMap newBeamState

