  2623661520 1700925778 153791746
  """

day05.puzzle.solutionPart1 : Nat
day05.puzzle.solutionPart1 = day05.solvePart1 day05.puzzle.input

day05.puzzle.solutionPart2 : Int
day05.puzzle.solutionPart2 = day05.solvePart2 day05.puzzle.input

day05.rangesSubtractRange : [IntRange] -> IntRange -> [IntRange]
day05.rangesSubtractRange ranges range =
  ranges |> List.flatMap (r -> subtract r range)

day05.rangesSubtractRanges : [IntRange] -> [IntRange] -> [IntRange]
day05.rangesSubtractRanges ranges rangesToSubtract =
  rangesToSubtract |> List.foldLeft rangesSubtractRange ranges

day05.rangeSubtractRanges : IntRange -> [IntRange] -> [IntRange]
day05.rangeSubtractRanges range rangesToSubtract =
  rangesSubtractRanges [range] rangesToSubtract

day05.solvePart1 : Text -> Nat
day05.solvePart1 input =
  (Almanac seeds maps) = utils.parseOrBug almanac input
  seeds
    |> List.map (seed -> lookupMulti maps seed)
    |> minimum
    |> getOrBug "no seeds"

test> day05.solvePart1.tests.example =
  check (day05.solvePart1 day05.example === 35)

test> day05.solvePart1.tests.puzzle =
  check (day05.solvePart1 day05.puzzle.input === 26273516)

day05.solvePart2 : Text -> Int
day05.solvePart2 input =
  (Almanac seeds maps) = utils.parseOrBug almanac input
  seedRanges = getSeedRanges seeds
  finalRanges = translateRangesAllMaps maps seedRanges
  finalRanges |> List.map IntRange.start |> minimum |> getOrBug "no seeds"

test> day05.solvePart2.tests.example =
  check (day05.solvePart2 day05.example === +46)

test> day05.solvePart2.tests.puzzle =
  check (day05.solvePart2 day05.puzzle.input === +34039469)

day05.translateRange : AlmanacMap -> IntRange -> [IntRange]
day05.translateRange almanacMap range =
  use List ++
  sourceRanges = almanacMap |> ranges |> List.map sourceRange
  unaffectedRanges = rangeSubtractRanges range sourceRanges
  modifiedRanges =
    ranges almanacMap
      |> List.filterMap (mapRange -> intersectAndTranslate mapRange range)
  unaffectedRanges ++ modifiedRanges

test> day05.translateRange.tests.test1 =
  check
    (translateRange
      (AlmanacMap
        "seed" "soil" [AlmanacMapRange 50 98 2, AlmanacMapRange 52 50 48])
      (IntRange +90 +10)
      === [IntRange +50 +2, IntRange +92 +8])

day05.translateRanges : AlmanacMap -> [IntRange] -> [IntRange]
day05.translateRanges almanacMap ranges =
  ranges |> List.flatMap (range -> translateRange almanacMap range)

day05.translateRangesAllMaps : [AlmanacMap] -> [IntRange] -> [IntRange]
day05.translateRangesAllMaps maps ranges =
  maps |> List.foldLeft (Function.flip translateRanges) ranges

day06.buttonTimes : Race -> (Nat, Nat)
day06.buttonTimes = cases
  Race raceDuration recordDistance ->
    (minButtonTime, maxButtonTime) =
      solveQuadratic
        1.0
        (-1.0 Float.* (raceDuration |> Float.fromNat))
        (recordDistance |> Float.fromNat)
    use Float toNat
    lowest =
      minimum [minButtonTime, maxButtonTime]
        |> getOrBug "cannot happen"
        |> ceiling
        |> toNat
        |> getOrBug "bad float"
    highest =
      maximum [minButtonTime, maxButtonTime]
        |> getOrBug "cannot happen"
        |> floor
        |> toNat
        |> getOrBug "bad float"
    (lowest, highest)

day06.distanceTravelled : Nat -> Nat -> Nat
day06.distanceTravelled raceLength timeButtonHeld =
  use Nat * -
  speed = timeButtonHeld
  travelTime = raceLength - timeButtonHeld
  speed * travelTime

test> day06.distanceTravelled.tests.example1 =
  check (distanceTravelled 7 0 === 0)

test> day06.distanceTravelled.tests.example2 =
  check (distanceTravelled 7 1 === 6)

test> day06.distanceTravelled.tests.example3 =
  check (distanceTravelled 7 2 === 10)

day06.example : Text
day06.example =
