day02.parser.green : '{Parse e} Colour
day02.parser.green = specificColour "green" Colour.Green

day02.parser.parseGame : Text -> Game
day02.parser.parseGame line = match Parse.run parser.game line with
  Either.Left _     -> bug "Could not parse game"
  Either.Right game -> game

day02.parser.red : '{Parse e} Colour
day02.parser.red = specificColour "red" Colour.Red

{{
Parse a revealed set of cubes from the bag, e.g. `"1 red, 2 green, 6 blue"`
}}
day02.parser.reveal : '{Parse e} Bag Colour
day02.parser.reveal = do
  use Bag +
  bags = sep1 (do text! ", ") bagSegment ()
  List.foldLeft (+) Bag.empty bags

test> day02.parser.reveal.tests.example =
  check (Parse.run reveal "12 red, 13 green, 14 blue" === Either.Right elfBag)

day02.parser.reveals : '{Parse e} [Bag Colour]
day02.parser.reveals = sep1 (do text! "; ") reveal

test> day02.parser.reveals.tests.example =
  use Bag addN empty
  use Colour Blue Green Red
  check
    (Parse.run parser.reveals "3 blue, 4 red; 1 red, 2 green, 6 blue; 2 green"
      === Either.Right
        [ empty |> addN 3 Blue |> addN 4 Red
        , empty |> addN 1 Red |> addN 2 Green |> addN 6 Blue
        , empty |> addN 2 Green
        ])

day02.parser.specificColour : Text -> Colour -> '{Parse e} Colour
day02.parser.specificColour name colour = do
  text! name
  colour

day02.power : Bag Colour -> Nat
day02.power bag =
  use Bag count
  use Nat *
  count Colour.Red bag * count Colour.Green bag * count Colour.Blue bag

test> day02.power.tests.example =
  exampleBag = makeColourBag 4 2 6
  check (power exampleBag === 48)

day02.run : '{IO, Exception} ()
day02.run = do
  use Nat toText
  use Text ++
  text = readFileUtf8 (FilePath "inputs/day-02.txt")
  answer1 = day02.solvePart1 text
  answer2 = day02.solvePart2 text
  printLine ("Answer to part 1: " ++ toText answer1)
  printLine ("Answer to part 2: " ++ toText answer2)

day02.solvePart1 : Text -> Nat
day02.solvePart1 input =
  games = input |> lines |> List.map parseGame
  games |> List.filter isGamePossible |> Nat.sumBy Game.id

test> day02.solvePart1.tests.example =
  use Nat ==
  example =
    """
    Game 1: 3 blue, 4 red; 1 red, 2 green, 6 blue; 2 green
    Game 2: 1 blue, 2 green; 3 green, 4 blue, 1 red; 1 green, 1 blue
    Game 3: 8 green, 6 blue, 20 red; 5 blue, 4 red, 13 green; 5 green, 1 red
    Game 4: 1 green, 3 red, 6 blue; 3 green, 6 red; 3 green, 15 blue, 14 red
    Game 5: 6 red, 1 blue, 3 green; 2 blue, 1 red, 2 green
    """
  check (day02.solvePart1 example == 8)

day02.solvePart2 : Text -> Nat
day02.solvePart2 input =
  games = input |> lines |> List.map parseGame
  games |> Nat.sumBy (Game.reveals >> unionAll >> power)

test> day02.solvePart2.tests.example =
  use Nat ==
  example =
    """
    Game 1: 3 blue, 4 red; 1 red, 2 green, 6 blue; 2 green
    Game 2: 1 blue, 2 green; 3 green, 4 blue, 1 red; 1 green, 1 blue
    Game 3: 8 green, 6 blue, 20 red; 5 blue, 4 red, 13 green; 5 green, 1 red
    Game 4: 1 green, 3 red, 6 blue; 3 green, 6 red; 3 green, 15 blue, 14 red
    Game 5: 6 red, 1 blue, 3 green; 2 blue, 1 red, 2 green
    """
  check (day02.solvePart2 example == 2286)

day02.unionAll : [Bag a] -> Bag a
day02.unionAll bags = List.foldLeft Bag.union Bag.empty bags

test> day02.unionAll.tests.example =
  exampleBag = [makeColourBag 4 0 3, makeColourBag 1 2 6, makeColourBag 0 2 0]
  check (unionAll exampleBag === makeColourBag 4 2 6)

day03.areAdjacent : PartNumber -> Symbol -> Boolean
day03.areAdjacent partNumber symbol =
  (PartNumber _ partRectangle) = partNumber
  (Symbol _ symbolPoint) = symbol
  Rectangle.contains (expandAllDirections partRectangle) symbolPoint

day03.EngineSchematic.empty : EngineSchematic
day03.EngineSchematic.empty =
  use Set empty
  EngineSchematic empty empty

day03.exampleText : Text
day03.exampleText =
  """
  467..114..
  ...*......
  ..35..633.
  ......#...
  617*......
  .....+.58.
  ..592.....
  ......755.
  ...$.*....
  .664.598..
  """

day03.parser.combineSchematics :
  EngineSchematic -> EngineSchematic -> EngineSchematic
day03.parser.combineSchematics schematic1 schematic2 =
  use Set union
  (EngineSchematic partNumbers1 symbols1) = schematic1
  (EngineSchematic partNumbers2 symbols2) = schematic2
  EngineSchematic (union partNumbers1 partNumbers2) (union symbols1 symbols2)

day03.parser.grindLine :
  Point -> [Char] -> Set PartNumber -> Set Symbol -> EngineSchematic
day03.parser.grindLine point cs partNumbers symbols =
  match cs with
    [] -> EngineSchematic partNumbers symbols
    c +: rest ->
      match c with
        ?. ->
          day03.parser.grindLine
            (point |> moveRight 1) rest partNumbers symbols
        c| isDigit c  ->
          (otherDigits, rest') = List.span isDigit rest
          use List +:
          digits = c +: otherDigits
          number =
            digits
              |> fromCharList
              |> Nat.fromText
              |> getOrBug "Could not parse number"
          endPoint = point |> moveRight (List.size otherDigits)
          location = Rectangle point endPoint
          partNumber = PartNumber number location
          day03.parser.grindLine
            (endPoint |> moveRight 1)
            rest'
            (Set.insert partNumber partNumbers)
            symbols
        _ ->
          symbol = Symbol (Char.toText c) point
          day03.parser.grindLine
            (point |> moveRight 1) rest partNumbers (Set.insert symbol symbols)

day03.parser.parseLine : Nat -> Text -> EngineSchematic
day03.parser.parseLine lineNumber line =
  use Set empty
  point = Point 0 lineNumber
  grindLine point (toCharList line) empty empty

test> day03.parser.parseLine.tests.example =
  use Set singleton
  check
    (parseLine 5 ".....+.58."
      === EngineSchematic
        (singleton (PartNumber 58 (Rectangle (Point 7 5) (Point 8 5))))
        (singleton (Symbol "+" (Point 5 5))))

day03.parser.parseSchematic : Text -> EngineSchematic
day03.parser.parseSchematic text =
  indexedLines = List.indexed (lines text)
  processLine : (Text, Nat) -> EngineSchematic
  processLine = cases (line, lineNumber) -> parseLine lineNumber line
  lineSchematics = List.map processLine indexedLines
  List.foldLeft combineSchematics EngineSchematic.empty lineSchematics

test> day03.parser.parseSchematic.tests.exampleCheck1 =
  use Nat ==
  check ((parseSchematic exampleText |> partNumbers |> Set.size) == 10)

test> day03.parser.parseSchematic.tests.exampleCheck2 =
  use Nat ==
  check ((parseSchematic exampleText |> symbols |> Set.size) == 6)

day03.run : '{IO, Exception} ()
day03.run = do
  use Nat toText
  use Text ++
  text = readFileUtf8 (FilePath "inputs/day-03.txt")
  answer1 = day03.solvePart1 text
  answer2 = day03.solvePart2 text
  printLine ("Answer 1: " ++ toText answer1)
  printLine ("Answer 2: " ++ toText answer2)

day03.solvePart1 : Text -> Nat
day03.solvePart1 input =
  schematic = parseSchematic input
  candidatePartNumbers = partNumbers schematic |> Set.toList
  symbols = EngineSchematic.symbols schematic
  isTruePartNumber : PartNumber -> Boolean
  isTruePartNumber partNumber =
    neighbourhood = PartNumber.location partNumber |> expandAllDirections
    symbols
      |> Set.any
        (symbol -> Rectangle.contains neighbourhood (Symbol.location symbol))
  candidatePartNumbers
    |> List.filter isTruePartNumber
    |> List.map PartNumber.number
    |> Nat.sum

test> day03.solvePart1.tests.example =
  check (day03.solvePart1 exampleText === 4361)

day03.solvePart2 : Text -> Nat
day03.solvePart2 input =
  use List filter map
  use Set toList
  use Text ==
  (EngineSchematic partNumbers symbols) = parseSchematic input
  gears = symbols |> toList |> filter (symbol -> Symbol.text symbol == "*")
  gearRatio : Symbol -> Nat
  gearRatio gear =
    adjacentPartNumbers =
      partNumbers
        |> toList
        |> filter (partNumber -> areAdjacent partNumber gear)
    if List.size adjacentPartNumbers === 2 then
      adjacentPartNumbers |> map PartNumber.number |> Nat.product
    else 0
  gears |> map gearRatio |> Nat.sum

test> day03.solvePart2.tests.example =
  check (day03.solvePart2 exampleText === 467835)

day04.cardWorth : day04.Card -> Nat
day04.cardWorth card =
  use Nat -
  winningNumbersCount = countWinningNumbers card
  if winningNumbersCount === 0 then 0 else Nat.pow 2 (winningNumbersCount - 1)

test> day04.cardWorth.tests.example1 =
  check
    (cardWorth
      (day04.Card.Card 1 [41, 48, 83, 86, 17] [83, 86, 6, 31, 17, 9, 48, 53])
      === 8)

test> day04.cardWorth.tests.example5 =
  check
    (cardWorth
      (day04.Card.Card 5 [87, 83, 26, 28, 32] [88, 30, 70, 12, 93, 22, 82, 36])
      === 0)

day04.countWinningNumbers : day04.Card -> Nat
day04.countWinningNumbers = cases
  day04.Card.Card _ winningNumbers numbersYouHave ->
    winningNumberSet = Set.fromList winningNumbers
    numbersYouHave
      |> List.count (number -> Set.contains number winningNumberSet)

