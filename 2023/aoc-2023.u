day13.isLineOfReflection : Nat -> [a] -> Boolean
day13.isLineOfReflection n xs =
  (prefix, suffix) = List.splitAt n xs
  List.zip (List.reverse prefix) suffix |> List.all (uncurry (===))

test> day13.isLineOfReflection.tests.example1Pattern2 =
  check
    ((day13.parser.parsePuzzleInput day13.inputs.example1
      |> List.at 1
      |> getOrBug "bug"
      |> rows
      |> isLineOfReflection 4)
      === true)

day13.parser.parsePattern : Text -> TerrainPattern
day13.parser.parsePattern = lines >> List.map parseRow >> TerrainPattern

day13.parser.parsePuzzleInput : Text -> [TerrainPattern]
day13.parser.parsePuzzleInput = splitAll "\n\n" >> List.map parsePattern

day13.parser.parseRow : Text -> [day13.Terrain]
day13.parser.parseRow =
  toCharList >> (List.map cases
    ?# -> day13.Terrain.Rock
    ?. -> Ash
    _  -> bug "Unexpected character")

day13.puzzle.solutionPart1 : Nat
day13.puzzle.solutionPart1 = day13.solvePart1 day13.inputs.puzzle

day13.puzzle.solutionPart2 : Nat
day13.puzzle.solutionPart2 = day13.solvePart2 day13.inputs.puzzle

day13.scoreReflectionLine : ReflectionLine -> Nat
day13.scoreReflectionLine = cases
  ReflectionLine axis index -> axisMultiplier axis Nat.* index

day13.scoreTerrainPatternPart1 : TerrainPattern -> Nat
day13.scoreTerrainPatternPart1 =
  findReflectionLines >> Set.toList >> Nat.sumBy scoreReflectionLine

day13.scoreTerrainPatternPart2 : TerrainPattern -> Nat
day13.scoreTerrainPatternPart2 pattern =
  findReflectionLinesAfterSmudge pattern
    |> Set.toList
    |> Nat.sumBy scoreReflectionLine

day13.smudge : day13.Terrain -> day13.Terrain
day13.smudge = cases
  day13.Terrain.Rock -> Ash
  Ash                -> day13.Terrain.Rock

day13.smudgeAt : Point -> TerrainPattern -> TerrainPattern
day13.smudgeAt = cases
  Point x y -> rows.modify (modifyListAt y (modifyListAt x smudge))

day13.solvePart1 : Text -> Nat
day13.solvePart1 =
  day13.parser.parsePuzzleInput >> Nat.sumBy scoreTerrainPatternPart1

test> day13.solvePart1.tests.example1 =
  check (day13.solvePart1 day13.inputs.example1 === 405)

test> day13.solvePart1.tests.puzzle =
  check (day13.solvePart1 day13.inputs.puzzle === 26957)

day13.solvePart2 : Text -> Nat
day13.solvePart2 =
  day13.parser.parsePuzzleInput >> Nat.sumBy scoreTerrainPatternPart2

test> day13.solvePart2.tests.example1 =
  check (day13.solvePart2 day13.inputs.example1 === 400)

day13.solvePart2PuzzleDistributed : '{IO, Exception} (Nat, Text)
day13.solvePart2PuzzleDistributed =
  measureTimeTaken
    (Cloud.main do
      environment = Environment.default()
      Cloud.submit environment do
        day13.parser.parsePuzzleInput day13.inputs.puzzle
          |> Remote.parMap scoreTerrainPatternPart2
          |> Nat.sum)

day13.solvePart2PuzzleSerially : '{IO, Exception} (Nat, Text)
day13.solvePart2PuzzleSerially = 
  measureTimeTaken do day13.solvePart2 day13.inputs.puzzle

day13.Terrain.toText : day13.Terrain -> Text
day13.Terrain.toText = cases
  day13.Terrain.Rock -> "#"
  Ash                -> "."

day13.TerrainPattern.allPoints : TerrainPattern -> [Point]
day13.TerrainPattern.allPoints pattern =
  use List size
  height = pattern |> rows |> size
  width = pattern |> rows |> List.head |> getOrBug "invalid pattern" |> size
  allInGrid width height

day13.TerrainPattern.toText : TerrainPattern -> Text
day13.TerrainPattern.toText =
  use List map
  use Text join
  rows >> map (map Terrain.toText >> join "") >> join "\n"

day13.transposePattern : TerrainPattern -> TerrainPattern
day13.transposePattern = rows.modify transpose

