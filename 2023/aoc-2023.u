day07.puzzle.solutionPart1 : Nat
day07.puzzle.solutionPart1 = day07.solvePart1 day07.puzzle.input

test> day07.puzzle.solutionPart2 =
  check (day07.solvePart2 day07.puzzle.input === 252113488)

day07.signature : Hand -> [Nat]
day07.signature hand =
  use Nat >
  hand
    |> cards
    |> Bag.fromList
    |> Bag.counts
    |> Map.values
    |> List.sort
    |> List.reverse
    |> List.filter (n -> n > 1)

day07.solvePart1 : Text -> Nat
day07.solvePart1 input =
  use Nat * +
  input
    |> utils.parseOrBug day07.parser.puzzleInput
    |> sortWith (lteqBy compareHandAndBids)
    |> List.indexed
    |> (Nat.sumBy cases (HandAndBid hand bid, index) -> (index + 1) * bid)

test> day07.solvePart1.tests.debug =
  check (day07.solvePart1 inputs.debug === 6592)

test> day07.solvePart1.tests.example =
  check (day07.solvePart1 day07.example === 6440)

test> day07.solvePart1.tests.puzzle =
  check (day07.solvePart1 day07.puzzle.input === 251806792)

day07.solvePart2 : Text -> Nat
day07.solvePart2 input = 
  withInitialValue Map.empty do
    input
      |> utils.parseOrBug day07.parser.puzzleInput
      |> sortWith (lteqBy compareHandAndBids2)
      |> List.indexed
      |> (Nat.sumBy cases
           (HandAndBid hand bid, index) -> (index Nat.+ 1) Nat.* bid)

test> day07.solvePart2.tests.debug =
  check (day07.solvePart2 inputs.debug === 6839)

test> day07.solvePart2.tests.example =
  check (day07.solvePart2 day07.example === 5905)

day07.weakenJacks : Hand -> Hand
day07.weakenJacks = cases
  Hand cards ->
    cards |> List.map (card -> (if card Nat.== joker then 1 else card)) |> Hand

test> day07.weakenJacks.tests.example =
  check
    (weakenJacks (utils.parseOrBug parser.hand "QJJQ2")
      === Hand [12, 1, 1, 12, 2])

day07.withEmptyMap : '{Store (Map a b)} c -> c
day07.withEmptyMap a = withInitialValue Map.empty a

day08.choose : day08.Direction -> (a, a) -> a
day08.choose = cases
  day08.Direction.Left, (left, _)   -> left
  day08.Direction.Right, (_, right) -> right

day08.finishingNode : day08.Node
day08.finishingNode = day08.Node.Node "ZZZ"

day08.getLeftRightPaths :
  day08.Node -> NodeMap -> Optional (day08.Node, day08.Node)
day08.getLeftRightPaths node = cases NodeMap nodeMap -> Map.get node nodeMap

day08.getStartingNodes : NodeMap -> [day08.Node]
day08.getStartingNodes nodeMap =
  nodeMap
    |> NodeMap.toMap
    |> Map.toList
    |> List.map at1
    |> List.filter (endsWith "A" << Node.toText)

test> day08.getStartingNodes.tests.example3 =
  use day08.Node Node
  check
    (getStartingNodes
      (day08.inputs.example3
        |> utils.parseOrBug day08.parser.puzzleInput
        |> PuzzleInput.nodes)
      === [Node "11A", Node "22A"])

day08.inputs.example1 : Text
day08.inputs.example1 =
  """
  RL
  
  AAA = (BBB, CCC)
  BBB = (DDD, EEE)
  CCC = (ZZZ, GGG)
  DDD = (DDD, DDD)
  EEE = (EEE, EEE)
  GGG = (GGG, GGG)
  ZZZ = (ZZZ, ZZZ)
  """

day08.inputs.example2 : Text
day08.inputs.example2 =
  """
  LLR
  
  AAA = (BBB, BBB)
  BBB = (AAA, ZZZ)
  ZZZ = (ZZZ, ZZZ)
  """

day08.inputs.example3 : Text
day08.inputs.example3 =
  """
  LR
  
  11A = (11B, XXX)
  11B = (XXX, 11Z)
  11Z = (11B, XXX)
  22A = (22B, XXX)
  22B = (22C, 22C)
  22C = (22Z, 22Z)
  22Z = (22B, 22B)
  XXX = (XXX, XXX)
  """

