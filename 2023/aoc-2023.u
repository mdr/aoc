day15.modifyBox :
  Nat -> ([Lens] ->{g} [Lens]) -> Map Nat [Lens] ->{g} Map Nat [Lens]
day15.modifyBox boxNumber f boxMap =
  lenses = Map.get boxNumber boxMap |> Optional.getOrElse []
  Map.insert boxNumber (f lenses) boxMap

day15.parser.parsePuzzleInput : Text -> [Step]
day15.parser.parsePuzzleInput = utils.parseOrBug parser.steps

day15.parser.parseRemoveStep : '{Parse e} Step
day15.parser.parseRemoveStep = atomic do
  label = takeAlphanum1()
  text! "-"
  Remove label

day15.parser.parseStep : '{Parse e} Step
day15.parser.parseStep = Parse.or parseRemoveStep parseUpsertStep

test> day15.parser.parseStep.tests.remove =
  check (utils.parseOrBug parseStep "cm-" === Remove "cm")

test> day15.parser.parseStep.tests.upsert =
  check (utils.parseOrBug parseStep "qp=3" === Upsert "qp" 3)

day15.parser.parseUpsertStep : '{Parse e} Step
day15.parser.parseUpsertStep = atomic do
  label = takeAlphanum1()
  text! "="
  value = numeric()
  Upsert label value

day15.parser.steps : '{Parse e} [Step]
day15.parser.steps = sep1 (Parse.text ",") parseStep

test> day15.parser.steps.tests.example1 =
  check
    (utils.parseOrBug
      parser.steps "rn=1,cm-,qp=3,cm=2,qp-,pc=4,ot=9,ab=5,pc-,pc=6,ot=7"
      === [ Upsert "rn" 1
      , Remove "cm"
      , Upsert "qp" 3
      , Upsert "cm" 2
      , Remove "qp"
      , Upsert "pc" 4
      , Upsert "ot" 9
      , Upsert "ab" 5
      , Remove "pc"
      , Upsert "pc" 6
      , Upsert "ot" 7
      ])

day15.removeLensFromBox : Text -> [Lens] -> [Lens]
day15.removeLensFromBox label = List.filter (lens -> Lens.label lens !== label)

day15.solvePart1 : Text -> Nat
day15.solvePart1 = splitAll "," >> Nat.sumBy day15.hash

test> day15.solvePart1.tests.example1 =
  check (day15.solvePart1 day15.inputs.example1 === 1320)

test> day15.solvePart1.tests.puzzle =
  check (day15.solvePart1 day15.inputs.puzzle === 516804)

day15.solvePart2 : Text -> Nat
day15.solvePart2 text =
  steps = day15.parser.parsePuzzleInput text
  run = do
    List.foreach steps handleStep
    Store.get
  withInitialValue Map.empty run |> sumFocusingPowers

test> day15.solvePart2.tests.example1 =
  check (day15.solvePart2 day15.inputs.example1 === 145)

test> day15.solvePart2.tests.puzzle =
  check (day15.solvePart2 day15.inputs.puzzle === 231844)

day15.sumFocusingPowers : Map Nat [Lens] -> Nat
day15.sumFocusingPowers boxMap =
  use Nat * + sumBy
  Nat.range 0 256
    |> sumBy
      (boxNumber ->
        let
          lenses = Map.get boxNumber boxMap |> Optional.getOrElse []
          lenses
            |> List.indexed
            |> (sumBy cases
                 (lens, index) ->
                   (boxNumber + 1) * (index + 1) * focusLength lens))

day15.upsertLensInBox : Lens -> [Lens] -> [Lens]
day15.upsertLensInBox lens = cases
  [] -> [lens]
  lens' +: rest ->
    if (lens' |> Lens.label) === (lens |> Lens.label) then lens List.+: rest
    else lens' List.+: day15.upsertLensInBox lens rest

day16.beamStep : Char -> BeamState ->{Each} BeamState
day16.beamStep tileCharacter = cases
  BeamState enteringPoint direction ->
    newDirection = eachNewBeamDirection direction tileCharacter
    newPoint = Point.move newDirection 1 enteringPoint
    BeamState newPoint newDirection

day16.countEnergisedTiles : TileMap -> BeamState -> Nat
day16.countEnergisedTiles tileMap initialBeamState =
  eachBeamState = do traceBeam tileMap initialBeamState
  exploredBeamStates = 
    withInitialValueReturningStore Set.empty do Each.run eachBeamState
  exploredBeamStates |> Set.map enteringPoint |> Set.size

day16.eachNewBeamDirection : utils.Direction -> Char ->{Each} utils.Direction
day16.eachNewBeamDirection direction = cases
  ?.  -> direction
  ?|  ->
    match direction with
      utils.Direction.Left  -> each [Up, Down]
      utils.Direction.Right -> each [Up, Down]
      _                     -> direction
  ?-  ->
    match direction with
      Up   -> each [utils.Direction.Left, utils.Direction.Right]
      Down -> each [utils.Direction.Left, utils.Direction.Right]
      _    -> direction
  ?\\ ->
    match direction with
      Up                    -> utils.Direction.Left
      Down                  -> utils.Direction.Right
      utils.Direction.Left  -> Up
      utils.Direction.Right -> Down
  ?/  ->
    match direction with
      Up                    -> utils.Direction.Right
      Down                  -> utils.Direction.Left
      utils.Direction.Left  -> Down
      utils.Direction.Right -> Up
  c   -> bug ("Unexpected character: " Text.++ Char.toText c)

day16.evolveBeam : utils.Direction -> Char -> [utils.Direction]
day16.evolveBeam direction char = 
  Each.toList do eachNewBeamDirection direction char

day16.getTileCharacter : TileMap -> Point ->{Each} Char
day16.getTileCharacter tileMap point =
  tilesByPoint tileMap |> Map.get point |> optionally

day16.initialBeamStates : TileMap -> [BeamState]
day16.initialBeamStates tileMap =
  use List ++ map
  use Nat rangeClosed
  (Rectangle (Point x1 y1) (Point x2 y2)) = TileMap.bounds tileMap
  downs = rangeClosed x1 x2 |> map (x -> BeamState (Point x y1) Down)
  ups = rangeClosed x1 x2 |> map (x -> BeamState (Point x y2) Up)
  rights =
    rangeClosed y1 y2
      |> map (y -> BeamState (Point x1 y) utils.Direction.Right)
  lefts =
    rangeClosed y1 y2 |> map (y -> BeamState (Point x2 y) utils.Direction.Left)
  downs ++ ups ++ rights ++ lefts

