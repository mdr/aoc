        , (Point 2 0, 3)
        , (Point 0 1, 4)
        , (Point 1 1, 5)
        , (Point 2 1, 6)
        ])

utils.grid.gridWidthAndHeight : [[a]] -> (Nat, Nat)
utils.grid.gridWidthAndHeight grid =
  use List size
  width = grid |> List.head |> getOrBug "invalid grid" |> size
  height = grid |> size
  (width, height)

utils.grid.lookup : [[a]] -> Point -> Optional a
utils.grid.lookup grid = cases
  Point x y -> grid |> List.at y |> Optional.flatMap (List.at x)

utils.grid.mapEverywhere : (a ->{g} b) -> [[a]] ->{g} [[b]]
utils.grid.mapEverywhere f =
  use List map
  map (map f)

utils.grid.pointIndexed : [[a]] -> [(a, Point)]
utils.grid.pointIndexed rows =
  use List indexed
  rows
    |> indexed
    |> (List.flatMap cases
         (row, y) ->
           row |> indexed |> (List.map cases (value, x) -> (value, Point x y)))

utils.grid.pointsWhere : (a ->{g} Boolean) -> [[a]] ->{g} [Point]
utils.grid.pointsWhere f =
  pointIndexed >> (List.filter cases (value, point) -> f value) >> List.map at2

utils.grid.textToCharArray2D : Text -> [[Char]]
utils.grid.textToCharArray2D = lines >> List.map toCharList

utils.grid.updateAt : Point -> (a ->{g} a) -> [[a]] ->{g} [[a]]
utils.grid.updateAt point f grid =
  (Point x y) = point
  grid |> modifyListAt y (modifyListAt x f)

utils.halveRoundingUp : Nat -> Nat
utils.halveRoundingUp n =
  use Nat + /
  (n + 1) / 2

test> utils.halveRoundingUp.tests.example1 = check (halveRoundingUp 1 === 1)

test> utils.halveRoundingUp.tests.example2 = check (halveRoundingUp 2 === 1)

test> utils.halveRoundingUp.tests.example3 = check (halveRoundingUp 3 === 2)

utils.indicesWhere : (a ->{g} Boolean) -> [a] ->{g} [Nat]
utils.indicesWhere f xs =
  xs |> List.indexed |> (List.filter cases (x, i) -> f x) |> List.map at2

utils.IntRange.contains : IntRange -> Int -> Boolean
utils.IntRange.contains range n =
  use Int + < <=
  (IntRange start length) = range
  start <= n && n < start + length

test> utils.IntRange.contains.tests.example0 =
  check (IntRange.contains (IntRange +1 +3) +0 === false)

test> utils.IntRange.contains.tests.example1 =
  check (IntRange.contains (IntRange +1 +3) +1 === true)

test> utils.IntRange.contains.tests.example2 =
  check (IntRange.contains (IntRange +1 +3) +2 === true)

test> utils.IntRange.contains.tests.example3 =
  check (IntRange.contains (IntRange +1 +3) +3 === true)

test> utils.IntRange.contains.tests.example4 =
  check (IntRange.contains (IntRange +1 +3) +4 === false)

utils.IntRange.endExclusive : IntRange -> Int
utils.IntRange.endExclusive = cases IntRange start length -> start Int.+ length

test> utils.IntRange.endExclusive.tests.example =
  check (endExclusive (IntRange +1 +3) === +4)

utils.IntRange.endInclusive : IntRange -> Int
utils.IntRange.endInclusive = cases
  IntRange start length -> start Int.+ length Int.- +1

test> utils.IntRange.endInclusive.tests.example =
  check (IntRange.endInclusive (IntRange +1 +3) === +3)

utils.IntRange.fromToInclusive : Int -> Int -> IntRange
utils.IntRange.fromToInclusive start endInclusive =
  use Int + -
  IntRange start (endInclusive - start + +1)

test> utils.IntRange.fromToInclusive.tests.example =
  check (IntRange.fromToInclusive +4 +10 === IntRange +4 +7)

utils.IntRange.intersect : IntRange -> IntRange -> Optional IntRange
utils.IntRange.intersect range1 range2 =
  use Int + - <=
  (IntRange start1 length1) = range1
  (IntRange start2 length2) = range2
  if start1 + length1 <= start2 then None
  else
    if start2 + length2 <= start1 then None
    else
      newStart = Int.max start1 start2
      newEnd = Int.min (start1 + length1) (start2 + length2)
      newLength = newEnd - newStart
      Some (IntRange newStart newLength)

test> utils.IntRange.intersect.tests.inclusion =
  check
    (IntRange.intersect (IntRange +0 +10) (IntRange +5 +5)
      === Some (IntRange +5 +5))

test> utils.IntRange.intersect.tests.noOverlap =
  check (IntRange.intersect (IntRange +0 +10) (IntRange +11 +5) === None)

test> utils.IntRange.intersect.tests.overlapping1 =
  check
    (IntRange.intersect (IntRange +0 +10) (IntRange +5 +10)
      === Some (IntRange +5 +5))

test> utils.IntRange.intersect.tests.overlapping2 =
  check
    (IntRange.intersect (IntRange +5 +10) (IntRange +0 +10)
      === Some (IntRange +5 +5))

utils.IntRange.subtract : IntRange -> IntRange -> [IntRange]
utils.IntRange.subtract range1 range2 =
  use Int + -
  use IntRange intersect
  (IntRange start1 length1) = range1
  (IntRange start2 length2) = range2
  maximalLeftSubrange = intersect (IntRange start1 (start2 - start1)) range1
  maximalRightSubrange =
    intersect
      (IntRange (start2 + length2) (start1 + length1 - start2 - length2))
      range1
  [maximalLeftSubrange, maximalRightSubrange] |> somes |> distinct

test> utils.IntRange.subtract.tests.inclusion1 =
  check
    (subtract (IntRange +0 +10) (IntRange +5 +2)
      === [IntRange +0 +5, IntRange +7 +3])

test> utils.IntRange.subtract.tests.inclusion2 =
  check (subtract (IntRange +5 +2) (IntRange +0 +10) === [])

test> utils.IntRange.subtract.tests.noOverlap1 =
  check (subtract (IntRange +0 +10) (IntRange +11 +5) === [IntRange +0 +10])

test> utils.IntRange.subtract.tests.noOverlap2 =
  check (subtract (IntRange +11 +5) (IntRange +0 +10) === [IntRange +11 +5])

test> utils.IntRange.subtract.tests.overlapping1 =
  check (subtract (IntRange +0 +10) (IntRange +5 +10) === [IntRange +0 +5])

test> utils.IntRange.subtract.tests.overlapping2 =
  check (subtract (IntRange +5 +10) (IntRange +0 +10) === [IntRange +10 +5])

utils.IntRange.translate : Int -> IntRange -> IntRange
utils.IntRange.translate offset range =
  use Int +
  IntRange.start.modify (n -> n + offset) range

utils.invertMap : Map a b -> Map b [a]
utils.invertMap = Map.map List.singleton >> invertMultimap

test> utils.invertMap.tests.example =
  use Map fromList
  check
    (invertMap (fromList [(1, 2), (2, 3), (3, 3)])
      === fromList [(2, [1]), (3, [2, 3])])

utils.invertMultimap : Map a [b] -> Map b [a]
utils.invertMultimap =
  Map.toList
    >> (List.flatMap cases (a, bs) -> bs |> List.map (b -> (b, a)))
    >> List.foldLeft
         (map b9a2rquadb1 -> let
           (b, a) = b9a2rquadb1
           Multimap.insert b a map) Map.empty

test> utils.invertMultimap.tests.example =
  use Map fromList
  check
    (invertMultimap (fromList [(1, [2, 3]), (2, [3, 4]), (3, [4, 5])])
      === fromList [(2, [1]), (3, [1, 2]), (4, [2, 3]), (5, [3])])

utils.iterateNTimes : Nat -> (a ->{g} a) -> a ->{g} a
utils.iterateNTimes n f x =
  use Nat - ==
  if n == 0 then x else utils.iterateNTimes (n - 1) f (f x)

utils.iterateUntil : (a ->{g1} Boolean) -> (a ->{g} a) -> a ->{g, g1} [a]
utils.iterateUntil stopPredicate f a =
  use List +:
  if stopPredicate a then [a]
  else a +: utils.iterateUntil stopPredicate f (f a)

test> utils.iterateUntil.tests.example =
  use Nat +
  check (iterateUntil (n -> n === 5) (n -> n + 1) 1 === [1, 2, 3, 4, 5])

utils.lcmAll : [Nat] -> Nat
utils.lcmAll = cases
  []        -> 1
  n +: rest -> unsafeLcm n (utils.lcmAll rest)

utils.measureTimeTaken : '{IO, Exception} a -> '{IO, Exception} (a, Text)
utils.measureTimeTaken action = do
  start = now()
  result = action()
  end = now()
  (result, Duration.between start end |> Duration.toText)

utils.modifyHead : (a ->{g} a) -> [a] ->{g} [a]
utils.modifyHead f = cases
  []      -> []
  x +: xs -> f x List.+: xs

utils.modifyListAt : Nat -> (a ->{g} a) -> [a] ->{g} [a]
utils.modifyListAt n f xs =
  value = List.at n xs |> getOrBug "No value"
  replace n (f value) xs

utils.NatRange.endInclusive : NatRange -> Nat
utils.NatRange.endInclusive = cases
  NatRange start length -> start Nat.+ length Nat.- 1

utils.NatRange.fromToInclusive : Nat -> Nat -> NatRange
utils.NatRange.fromToInclusive start endInclusive =
  use Nat + -
  NatRange start (endInclusive - start + 1)

utils.parseOrBug : '{Parse e} a -> Text -> a
utils.parseOrBug parser text = Parse.run parser text |> Either.toBug

(utils.parser.$>) : '{g} a -> b -> '{g} b
a utils.parser.$> b = do
  ignore a()
  b

utils.parser.count! : Nat -> '{g, Parse e} a ->{g, Parse e} [a]
utils.parser.count! n p = match n with
  0 -> []
  _ ->
    use List +:
    use Nat -
    a = p()
    as = utils.parser.count! (n - 1) p
    a +: as

utils.parser.parseThenMaybeWhitespace : '{Parse e} a -> '{Parse e} a
utils.parser.parseThenMaybeWhitespace parser = do
  a = parser()
  _ = optional! skipWhitespace
  a

utils.Point.allInGrid : Nat -> Nat -> [Point]
utils.Point.allInGrid width height =
  eachPoint : '{Each} Point
  eachPoint = do
    use Nat range
    x = each (range 0 width)
    y = each (range 0 height)
    Point x y
  Each.toList eachPoint

utils.Point.down : Point -> Point
utils.Point.down point =
  use Nat +
  y.modify (y -> y + 1) point

utils.Point.left : Point -> Point
utils.Point.left =
  use Nat -
  x.modify (x -> x - 1)

utils.Point.manhattenDistance : Point -> Point -> Nat
utils.Point.manhattenDistance p1 p2 =
  use Nat + diff
  (Point x1 y1) = p1
  (Point x2 y2) = p2
  diff x1 x2 + diff y1 y2

utils.Point.move : utils.Direction -> Nat -> Point -> Point
utils.Point.move = cases
  Up                    -> moveUp
  Down                  -> moveDown
  utils.Direction.Left  -> moveLeft
  utils.Direction.Right -> moveRight

utils.Point.moveDown : Nat -> Point -> Point
utils.Point.moveDown n =
  use Nat +
  y.modify (y -> y + n)

utils.Point.moveLeft : Nat -> Point -> Point
utils.Point.moveLeft n =
  use Nat -
  x.modify (x -> x - n)

utils.Point.moveRight : Nat -> Point -> Point
utils.Point.moveRight n = cases Point x y -> Point (x Nat.+ n) y

utils.Point.moveUp : Nat -> Point -> Point
utils.Point.moveUp n =
  use Nat -
  y.modify (y -> y - n)

utils.Point.neighbours : Point -> [Point]
utils.Point.neighbours point =
  Direction.all |> List.map (direction -> Point.move direction 1 point)

utils.Point.right : Point -> Point
utils.Point.right =
  use Nat +
  x.modify (x -> x + 1)

utils.Point.up : Point -> Point
utils.Point.up =
  use Nat -
  y.modify (y -> y - 1)

utils.precomposeOrdering :
  (a ->{g2} b) -> (b ->{g1} b ->{g} Ordering) -> a -> a ->{g, g1, g2} Ordering
utils.precomposeOrdering f ordering a1 a2 = ordering (f a1) (f a2)

utils.readText : Text ->{IO, Exception} Text
utils.readText path = readFileUtf8 (FilePath path)

utils.Rectangle.contains : Rectangle -> Point -> Boolean
utils.Rectangle.contains rectangle = cases
  Point x y ->
    (Rectangle (Point topLeftX topLeftY) (Point bottomRightX bottomRightY)) =
      rectangle
    topLeftX Nat.<= x && x Nat.<= bottomRightX && topLeftY Nat.<= y
      && y Nat.<= bottomRightY

test> utils.Rectangle.contains.tests.internalPoint =
  rectangle = Rectangle (Point 0 0) (Point 2 2)
  check (iff (Rectangle.contains rectangle (Point 1 1)) true)

test> utils.Rectangle.contains.tests.outside =
  rectangle = Rectangle (Point 0 0) (Point 2 2)
  check (iff (Rectangle.contains rectangle (Point 3 3)) false)

test> utils.Rectangle.contains.tests.topLeft =
  rectangle = Rectangle (Point 0 0) (Point 2 2)
  check (iff (Rectangle.contains rectangle (Point 0 0)) true)

utils.Rectangle.expandAllDirections : Rectangle -> Rectangle
utils.Rectangle.expandAllDirections = cases
  Rectangle (Point topLeftX topLeftY) (Point bottomRightX bottomRightY) ->
    Rectangle
      (Point (topLeftX Nat.- 1) (topLeftY Nat.- 1))
      (Point (bottomRightX Nat.+ 1) (bottomRightY Nat.+ 1))

utils.Rectangle.height : Rectangle -> Nat
utils.Rectangle.height = cases
  Rectangle topLeft bottomRight ->
    (Point _ top) = topLeft
    (Point _ bottom) = bottomRight
    bottom Nat.- top Nat.+ 1

test> utils.Rectangle.height.tests.example =
  check ((Rectangle (Point 1 1) (Point 10 131) |> Rectangle.height) === 131)

utils.Rectangle.width : Rectangle -> Nat
utils.Rectangle.width = cases
  Rectangle topLeft bottomRight ->
    (Point left _) = topLeft
    (Point right _) = bottomRight
    right Nat.- left Nat.+ 1

test> utils.Rectangle.width.tests.example =
  check ((Rectangle (Point 1 1) (Point 131 10) |> width) === 131)

utils.rotateLeft : [a] -> [a]
utils.rotateLeft = cases
  []            -> []
  first +: rest -> rest :+ first

test> utils.rotateLeft.tests.empty = check (utils.rotateLeft [] === [])

test> utils.rotateLeft.tests.example =
  check (utils.rotateLeft [1, 2, 3] === [2, 3, 1])

utils.rotateRight : [a] -> [a]
utils.rotateRight xs = match List.unsnoc xs with
  None              -> []
  Some (init, last) -> last List.+: init

test> utils.rotateRight.tests.empty = check (utils.rotateRight [] === [])

test> utils.rotateRight.tests.example =
  check (utils.rotateRight [1, 2, 3] === [3, 1, 2])

utils.runAskWithStream : '{Stream a} Void -> '{g, Ask a} c -> '{g} c
utils.runAskWithStream stream body = do runAskWithStream! stream body

test> utils.runAskWithStream.test.example =
  check
    ((runAskWithStream! (Stream.fromList [1, 2] |> forever') do
      [ask, ask, ask, ask, ask])
      === [1, 2, 1, 2, 1])

utils.runAskWithStream! : '{Stream a} Void -> '{g, Ask a} c ->{g} c
utils.runAskWithStream! stream body =
  handler : '{Stream a} Void -> Request (Ask a) c -> c
  handler stream = cases
    { ask -> k } ->
      (Either.Right (next, stream')) = Stream.uncons stream
      handle k next with handler stream'
    { result }   -> result
  handle body() with handler stream

utils.snd : (a, b) -> b
utils.snd = cases (a, b) -> b

utils.solveQuadratic : Float -> Float -> Float -> (Float, Float)
utils.solveQuadratic a b c =
  use Float * + - /
  d = b * b - 4.0 * a * c
  solution1 = (-1.0 * b + sqrt d) / (2.0 * a)
  solution2 = (-1.0 * b - sqrt d) / (2.0 * a)
  (solution1, solution2)

test> utils.solveQuadratic.tests.example1 =
  check (solveQuadratic 5.0 6.0 1.0 === (-0.2, -1.0))

utils.solveRemote : Boolean -> '{Remote} a -> '{IO, Exception} (a, Text)
utils.solveRemote useCloud solve =
  cloudMain = if useCloud then Cloud.main else main.local
  measureTimeTaken (cloudMain do Cloud.submit Environment.default() solve)

utils.splitAll : Text -> Text -> [Text]
utils.splitAll separator text =
  text
    |> toCharList
    |> splitAll' (toCharList separator) []
    |> List.map fromCharList

test> utils.splitAll.tests.case1 =
  check (splitAll "," "a,b,c" === ["a", "b", "c"])

test> utils.splitAll.tests.case2 =
  check (splitAll "," "a,b,c," === ["a", "b", "c", ""])

test> utils.splitAll.tests.case3 =
  check (splitAll "!!" "!!b!!c!!d" === ["", "b", "c", "d"])

utils.splitAll' : [Char] -> [Char] -> [Char] -> [[Char]]
utils.splitAll' separator chunkSoFar chars = match chars with
  []      -> [chunkSoFar]
  c +: cs ->
    match stripPrefix separator chars with
      None     -> utils.splitAll' separator (chunkSoFar :+ c) cs
      Some cs' -> chunkSoFar List.+: utils.splitAll' separator [] cs'

utils.Store.withInitialValueReturningStore : a -> '{g, Store a} v ->{g} a
utils.Store.withInitialValueReturningStore initialValue f = 
  withInitialValue initialValue do getFinalStoreValue f

utils.stream.indexOf : a -> '{g, Stream a} b -> '{g} Optional Nat
utils.stream.indexOf element stream = do indexOf! element stream

utils.stream.indexOf! : a -> '{g, Stream a} b ->{g} Optional Nat
utils.stream.indexOf! element = indexWhere! (x -> x === element)

test> utils.stream.indexOf!.tests.finiteAbsent =
  check (indexOf! 4 (Stream.fromList [1, 2, 3]) === None)

test> utils.stream.indexOf!.tests.finitePresent =
  check (indexOf! 2 (Stream.fromList [1, 2, 3, 2, 1]) === Some 1)

test> utils.stream.indexOf!.tests.infinitePresent =
  check (indexOf! 2 (Stream.fromList [1, 2, 3, 2, 1] |> forever') === Some 1)

utils.stream.indexWhere :
  (a -> Boolean) -> '{g, Stream a} b -> '{g} Optional Nat
utils.stream.indexWhere predicate stream = do indexWhere! predicate stream

utils.stream.indexWhere! :
  (a -> Boolean) -> '{g, Stream a} b ->{g} Optional Nat
utils.stream.indexWhere! predicate stream =
  use Nat +
  handler : (a -> Boolean) -> Nat -> Request (Stream a) c -> Optional Nat
  handler predicate index = cases
    { emit a -> k } ->
      if predicate a then Some index
      else handle k() with handler predicate (index + 1)
    { result } -> None
  handle stream() with handler predicate 0

utils.stream.zipMany : ['{g, Stream a} r] -> '{g, Stream [a]} r
utils.stream.zipMany streams =
  use List +:
  emptyListStream : '{Stream [a]} r
  emptyListStream = do
    _ = Stream.repeat (do []) ()
    bug "Cannot happen"
  List.foldRight (Stream.zipWith (+:)) emptyListStream streams

test> utils.stream.zipMany.tests.example =
  use Stream fromList
  check
    ((zipMany [fromList [1, 2, 3], fromList [4, 5, 6], fromList [7, 8, 9, 10]]
      |> toList!)
      === [[1, 4, 7], [2, 5, 8], [3, 6, 9]])

utils.todo! : b
utils.todo! = bug "todo"

utils.traceIterateNTimes : Nat -> (a ->{g} a) -> a ->{g} [a]
utils.traceIterateNTimes n f x =
  use List +:
  use Nat - ==
  if n == 0 then [x] else x +: utils.traceIterateNTimes (n - 1) f (f x)

utils.triangularNumber : Nat -> Nat
utils.triangularNumber n =
  use Nat * + /
  n * (n + 1) / 2

test> utils.triangularNumber.tests.examples =
  check
    ((Nat.rangeClosed 0 10 |> List.map triangularNumber)
      === [0, 1, 3, 6, 10, 15, 21, 28, 36, 45, 55])

utils.unsafeLcm : Nat -> Nat -> Nat
utils.unsafeLcm a b = (toOptional! do Nat.lcm a b) |> getOrBug "lcm failed"
