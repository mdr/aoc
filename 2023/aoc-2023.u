day04.puzzle.solutionPart1 : Nat
day04.puzzle.solutionPart1 = day04.solvePart1 day04.puzzle.input

day04.puzzle.solutionPart2 : Nat
day04.puzzle.solutionPart2 = day04.solvePart2 day04.puzzle.input

day04.run : '{IO, Exception} ()
day04.run = do
  use Nat toText
  use Text ++
  text = readText "inputs/day-04.txt"
  answer1 = day04.solvePart1 text
  printLine ("Answer 1: " ++ toText answer1)
  answer2 = day04.solvePart2 text
  printLine ("Answer 2: " ++ toText answer2)

day04.scorePart2 : [day04.Card] -> Bag Nat -> Bag Nat
day04.scorePart2 cards cardCounts = List.foldLeft processCard cardCounts cards

day04.solvePart1 : Text -> Nat
day04.solvePart1 input =
  cards = input |> lines |> List.map parseCard
  cards |> Nat.sumBy cardWorth

test> day04.solvePart1.tests.example =
  check (day04.solvePart1 day04.example === 13)

test> day04.solvePart1.tests.puzzle =
  check (day04.puzzle.solutionPart1 === 28750)

day04.solvePart2 : Text -> Nat
day04.solvePart2 input =
  use List map
  cards = input |> lines |> map parseCard
  initialCardCounts = cards |> map cardNumber |> Bag.fromList
  finalCardCounts = scorePart2 cards initialCardCounts
  Bag.size finalCardCounts

test> day04.solvePart2.tests.example =
  check (day04.solvePart2 day04.example === 30)

test> day04.solvePart2.tests.puzzle =
  check (day04.puzzle.solutionPart2 === 10212704)

day05.almanacMapLookup : AlmanacMap -> Nat -> Nat
day05.almanacMapLookup almanacMap sourceNumber =
  almanacMap
    |> ranges
    |> findMap (range -> mapRangeLookup range sourceNumber)
    |> Optional.getOrElse sourceNumber

test> day05.almanacMapLookup.tests.example1 =
  check
    (almanacMapLookup
      (AlmanacMap
        "seed" "soil" [AlmanacMapRange 50 98 2, AlmanacMapRange 52 50 48])
      53
      === 55)

test> day05.almanacMapLookup.tests.example2 =
  check
    (almanacMapLookup
      (AlmanacMap
        "seed" "soil" [AlmanacMapRange 50 98 2, AlmanacMapRange 52 50 48])
      10
      === 10)

day05.AlmanacMapRange.sourceRange : AlmanacMapRange -> IntRange
day05.AlmanacMapRange.sourceRange = cases
  AlmanacMapRange _ sourceStart length ->
    IntRange (Nat.toInt sourceStart) (Nat.toInt length)

day05.example : Text
day05.example =
  """
  seeds: 79 14 55 13
  
  seed-to-soil map:
  50 98 2
  52 50 48
  
  soil-to-fertilizer map:
  0 15 37
  37 52 2
  39 0 15
  
  fertilizer-to-water map:
  49 53 8
  0 11 42
  42 0 7
  57 7 4
  
  water-to-light map:
  88 18 7
  18 25 70
  
  light-to-temperature map:
  45 77 23
  81 45 19
  68 64 13
  
  temperature-to-humidity map:
  0 69 1
  1 0 69
  
  humidity-to-location map:
  60 56 37
  56 93 4
  """

day05.getSeedRanges : [Nat] -> [IntRange]
day05.getSeedRanges ns =
  asRange : [Int] -> Optional IntRange
  asRange = cases
    [start, length] -> Some (IntRange start length)
    _               -> None
  ns |> List.map Nat.toInt |> List.chunk 2 |> List.filterMap asRange

test> day05.getSeedRanges.tests.example =
  check
    (getSeedRanges [79, 14, 55, 13] === [IntRange +79 +14, IntRange +55 +13])

day05.intersectAndTranslate : AlmanacMapRange -> IntRange -> Optional IntRange
day05.intersectAndTranslate mapRange range =
  use Int -
  sourceRange = mapRange |> AlmanacMapRange.sourceRange
  offset =
    (destinationStart mapRange |> Nat.toInt) - IntRange.start sourceRange
  IntRange.intersect sourceRange range |> Optional.map (translate offset)

day05.lookupMulti : [AlmanacMap] -> Nat -> Nat
day05.lookupMulti maps itemNumber =
  List.foldLeft (Function.flip almanacMapLookup) itemNumber maps

day05.mapRangeLookup : AlmanacMapRange -> Nat -> Optional Nat
day05.mapRangeLookup mapRange sourceNumber =
  use Nat + - < >=
  (AlmanacMapRange destinationStart sourceStart length) = mapRange
  if sourceNumber >= sourceStart && sourceNumber < sourceStart + length then
    Some (destinationStart + sourceNumber - sourceStart)
  else None

test> day05.mapRangeLookup.tests.example1 =
  check (mapRangeLookup (AlmanacMapRange 50 98 2) 97 === None)

test> day05.mapRangeLookup.tests.example2 =
  check (mapRangeLookup (AlmanacMapRange 50 98 2) 98 === Some 50)

test> day05.mapRangeLookup.tests.example3 =
  check (mapRangeLookup (AlmanacMapRange 50 98 2) 99 === Some 51)

test> day05.mapRangeLookup.tests.example4 =
  check (mapRangeLookup (AlmanacMapRange 50 98 2) 100 === None)

day05.parser.almanac : '{Parse e} Almanac
day05.parser.almanac = do
  seeds = parser.seeds()
  skipWhitespace()
  maps = many! almanacMap
  Almanac seeds maps

test> day05.parser.almanac.tests.example =
  check
    (Parse.run almanac day05.example
      === Either.Right
        (Almanac
          [79, 14, 55, 13]
          [ AlmanacMap
              "seed" "soil" [AlmanacMapRange 50 98 2, AlmanacMapRange 52 50 48]
          , AlmanacMap
              "soil"
              "fertilizer"
              [ AlmanacMapRange 0 15 37
              , AlmanacMapRange 37 52 2
              , AlmanacMapRange 39 0 15
              ]
          , AlmanacMap
              "fertilizer"
              "water"
              [ AlmanacMapRange 49 53 8
              , AlmanacMapRange 0 11 42
              , AlmanacMapRange 42 0 7
              , AlmanacMapRange 57 7 4
              ]
          , AlmanacMap
              "water"
              "light"
              [AlmanacMapRange 88 18 7, AlmanacMapRange 18 25 70]
          , AlmanacMap
              "light"
              "temperature"
              [ AlmanacMapRange 45 77 23
              , AlmanacMapRange 81 45 19
              , AlmanacMapRange 68 64 13
              ]
          , AlmanacMap
              "temperature"
              "humidity"
              [AlmanacMapRange 0 69 1, AlmanacMapRange 1 0 69]
          , AlmanacMap
              "humidity"
              "location"
              [AlmanacMapRange 60 56 37, AlmanacMapRange 56 93 4]
          ]))

day05.parser.almanacMap : '{Parse e} AlmanacMap
day05.parser.almanacMap = do
  (sourceCategory, destinationCategory) = mapHeader()
  skipWhitespace()
  mapRangeMaybeWhitespace = do
    map = mapRange()
    _ = optional! skipWhitespace
    map
  ranges = many! mapRangeMaybeWhitespace
  AlmanacMap sourceCategory destinationCategory ranges

test> day05.parser.almanacMap.tests.example =
  check
    (Parse.run almanacMap "soil-to-fertilizer map:\n0 15 37\n37 52 2\n39 0 15"
      === Either.Right
        (AlmanacMap
          "soil"
          "fertilizer"
          [ AlmanacMapRange 0 15 37
          , AlmanacMapRange 37 52 2
          , AlmanacMapRange 39 0 15
          ]))

day05.parser.mapHeader : '{Parse e} (Text, Text)
day05.parser.mapHeader = do
  sourceCategory = takeAlphanum1()
  text! "-to-"
  destinationCategory = takeAlphanum1()
  text! " map:"
  (sourceCategory, destinationCategory)

test> day05.parser.mapHeader.tests.example =
  check
    (Parse.run mapHeader "soil-to-fertilizer map:"
      === Either.Right ("soil", "fertilizer"))

day05.parser.mapRange : '{Parse e} AlmanacMapRange
day05.parser.mapRange = do
  destinationStart = numeric()
  skipWhitespace()
  sourceStart = numeric()
  skipWhitespace()
  length = numeric()
  AlmanacMapRange destinationStart sourceStart length

day05.parser.seeds : '{Parse e} [Nat]
day05.parser.seeds = do
  text! "seeds: "
  sep1! (do text! " ") numeric

test> day05.parser.seeds.tests.example =
  check
    (Parse.run parser.seeds "seeds: 79 14 55 13"
      === Either.Right [79, 14, 55, 13])

test> day05.parser.tests.example =
  check
    (Parse.run mapRange "0 15 37" === Either.Right (AlmanacMapRange 0 15 37))

