    ((utils.parseOrBug timesheet day06.example |> getRaces)
      === [Race 7 9, Race 15 40, Race 30 200])

day06.parser.lineOfTimes : Text ->{Parse e} [Nat]
day06.parser.lineOfTimes prefix =
  text! prefix
  skipWhitespace()
  many! day04.parser.numberMaybeWhitespace

day06.parser.times : '{Parse e} [Nat]
day06.parser.times = do lineOfTimes "Time:"

