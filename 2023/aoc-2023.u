day08.makeNodeMap :
  [NodeInstructions] -> Map day08.Node (day08.Node, day08.Node)
day08.makeNodeMap nodes =
  nodes
    |> List.map
         (node ->
           ( NodeInstructions.label node
           , (NodeInstructions.left node, NodeInstructions.right node)
           ))
    |> Map.fromList

day08.nodeIsFinished : day08.Node -> Boolean
day08.nodeIsFinished = endsWith "Z" << Node.toText

day08.nodesAreFinished : [day08.Node] -> Boolean
day08.nodesAreFinished = List.all nodeIsFinished

day08.parser.direction : '{Parse e} day08.Direction
day08.parser.direction =
  do
    or!
      (Parse.text "L" $> day08.Direction.Left)
      (Parse.text "R" $> day08.Direction.Right)

day08.parser.directions : '{Parse e} [day08.Direction]
day08.parser.directions = Parse.many day08.parser.direction

day08.parser.nodeInstructions : '{Parse e} NodeInstructions
day08.parser.nodeInstructions = do
  use day08.Node Node
  label = takeAlphanum1() |> Node
  text! " = ("
  left = takeAlphanum1() |> Node
  text! ", "
  right = takeAlphanum1() |> Node
  text! ")"
  NodeInstructions label left right

test> day08.parser.nodeInstructions.tests.example =
  use day08.Node Node
  check
    (utils.parseOrBug nodeInstructions "AAA = (BBB, CCC)"
      === NodeInstructions (Node "AAA") (Node "BBB") (Node "CCC"))

day08.parser.puzzleInput : '{Parse e} day08.PuzzleInput
day08.parser.puzzleInput = do
  directions = parser.directions()
  text! "\n\n"
  nodes = many! (parseThenMaybeWhitespace nodeInstructions)
  day08.PuzzleInput.PuzzleInput directions (NodeMap (makeNodeMap nodes))

test> day08.parser.puzzleInput.tests.example2 =
  use day08.Direction Left
  use day08.Node Node
  check
    (utils.parseOrBug day08.parser.puzzleInput day08.inputs.example2
      === day08.PuzzleInput.PuzzleInput
        [Left, Left, day08.Direction.Right]
        (NodeMap
          (Map.fromList
            [ (Node "AAA", (Node "BBB", Node "BBB"))
            , (Node "BBB", (Node "AAA", Node "ZZZ"))
            , (Node "ZZZ", (Node "ZZZ", Node "ZZZ"))
            ])))

day08.puzzle.solutionPart1 : Nat
day08.puzzle.solutionPart1 = day08.solvePart1 day08.inputs.puzzle

test> day08.puzzle.solutionPart1.tests.puzzle =
  check (day08.puzzle.solutionPart1 === 18113)

day08.solvePart1 : Text -> Nat
day08.solvePart1 input =
  (day08.PuzzleInput.PuzzleInput directions nodeMap) =
    input |> utils.parseOrBug day08.parser.puzzleInput
  traceJourney nodeMap directions startingNode
    |> indexOf! finishingNode
    |> getOrBug "ZZZ not found in journey"

test> day08.solvePart1.tests.example1 =
  check (day08.solvePart1 day08.inputs.example1 === 2)

test> day08.solvePart1.tests.example2 =
  check (day08.solvePart1 day08.inputs.example2 === 6)

test> day08.solvePart1.tests.puzzle =
  check (day08.solvePart1 day08.inputs.puzzle === 18113)

day08.solvePart2 : Text -> Nat
day08.solvePart2 input =
  (day08.PuzzleInput.PuzzleInput directions nodeMap) =
    input |> utils.parseOrBug day08.parser.puzzleInput
  firstFinishedIndex node =
    traceJourney nodeMap directions node
      |> indexWhere! nodeIsFinished
      |> getOrBug "Never finishes"
  getStartingNodes nodeMap
    |> List.map firstFinishedIndex
    |> List.foldLeft unsafeLcm 1

test> day08.solvePart2.tests.example3 =
  check (day08.solvePart2 day08.inputs.example3 === 6)

test> day08.solvePart2.tests.puzzle =
  check (day08.solvePart2 day08.inputs.puzzle === 12315788159977)

day08.solvePart2TooSlow : Text -> Nat
day08.solvePart2TooSlow input =
  (day08.PuzzleInput.PuzzleInput directions nodeMap) =
    input |> utils.parseOrBug day08.parser.puzzleInput
  getStartingNodes nodeMap
    |> List.map (traceJourney nodeMap directions)
    |> zipMany
    |> indexWhere! nodesAreFinished
    |> getOrBug "No simultaneous journey finished"

day08.startingNode : day08.Node
day08.startingNode = day08.Node.Node "AAA"

day08.traceJourney :
  NodeMap -> [day08.Direction] -> day08.Node -> '{Stream day08.Node} ()
day08.traceJourney nodeMap directions node =
  directionsStream = Stream.fromList directions |> forever'
  traceJourney' nodeMap node |> runAskWithStream directionsStream

day08.traceJourney' :
  NodeMap -> day08.Node -> '{Ask day08.Direction, Stream day08.Node} ()
day08.traceJourney' nodeMap currentNode = do
  emit currentNode
  match getLeftRightPaths currentNode nodeMap with
    Some (left, right) ->
      directionToTake = ask
      nextNode = day08.choose directionToTake (left, right)
      day08.traceJourney' nodeMap nextNode ()
    None               -> ()

day09.allZeros : [Int] -> Boolean
day09.allZeros =
  use Int ==
  List.all ((==) +0)

day09.differences : [Int] -> [Int]
day09.differences ns =
  use Int -
  List.zipWith (-) (List.drop 1 ns) ns

test> day09.differences.tests.firstDifference =
  check (differences [+0, +3, +6, +9, +12, +15] === [+3, +3, +3, +3, +3])

test> day09.differences.tests.secondDifference =
  check (differences [+3, +3, +3, +3, +3] === [+0, +0, +0, +0])

day09.extrapolateHistory : [Int] -> Int
day09.extrapolateHistory =
  iterateDifferences >> Int.sumBy (List.last >> getOrBug "empty history")

test> day09.extrapolateHistory.tests.example1 =
  check (extrapolateHistory [+0, +3, +6, +9, +12, +15] === +18)

test> day09.extrapolateHistory.tests.example2 =
  check (extrapolateHistory [+1, +3, +6, +10, +15, +21] === +28)

test> day09.extrapolateHistory.tests.example3 =
  check (extrapolateHistory [+10, +13, +16, +21, +30, +45] === +68)

day09.extrapolateHistoryBackwards : [Int] -> Int
day09.extrapolateHistoryBackwards = List.reverse >> extrapolateHistory

test> day09.extrapolateHistoryBackwards.tests.example1 =
  check (extrapolateHistoryBackwards [+0, +3, +6, +9, +12, +15] === -3)

test> day09.extrapolateHistoryBackwards.tests.example2 =
  check (extrapolateHistoryBackwards [+1, +3, +6, +10, +15, +21] === +0)

test> day09.extrapolateHistoryBackwards.tests.example3 =
  check (extrapolateHistoryBackwards [+10, +13, +16, +21, +30, +45] === +5)

day09.inputs.example : Text
day09.inputs.example =
