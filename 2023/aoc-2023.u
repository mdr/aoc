  .......#.............#.............................###.......#.....................................##...#..............##......#...
  ..............##.................#......#...................................#.##.......................#....#.......#.#..........#.
  .##.........#...##..###........#.#...#..#.......#...#..............................#.....##.............#..#...........#.....#...#.
  .#.........#.#...........#.............#......#.........#...................##..................#.#....#..#..........#......#......
  ........##......#..#..................................#...........................#.#....................##.............#..........
  ...#..#.....#......#....#...#................#.....#..............................#........................#........#....#.........
  ...#......#........#..#.......................#.....#...................#............#.......##..................#..#....#..###....
  ........#.....#..............#...#.#..#..#.......#.#.....#.........................#........#.......#....##......#.............#.#.
  ...................................................................................................................................
  """

day21.parser.parseFarm : Text -> Farm
day21.parser.parseFarm text =
  use Char ==
  use Nat -
  grid = text |> textToCharArray2D
  start =
    grid
      |> pointsWhere (c -> c == ?S)
      |> List.head
      |> getOrBug "no start found"
  terrainGrid =
    grid.updateAt start (c -> ?.) grid
      |> mapEverywhere day21.parser.parseTerrain
  farmStart = start |> moveRight 1 |> moveDown 1
  (width, height) = gridWidthAndHeight grid
  topLeft = Point 1 1
  bottomRight = topLeft |> moveRight (width - 1) |> moveDown (height - 1)
  bounds = Rectangle topLeft bottomRight
  Farm terrainGrid bounds farmStart

day21.parser.parseTerrain : Char -> day21.Terrain
day21.parser.parseTerrain = cases
  ?. -> Plot
  ?# -> day21.Terrain.Rock
  c  -> bug ("invalid terrain: " Text.++ (c |> Char.toText))

day21.plotsReachable : Farm -> Nat -> Nat
day21.plotsReachable farm numberOfSteps =
  start = Set.singleton (Farm.start farm)
  step farm start numberOfSteps |> Set.size

test> day21.plotsReachable.tests.example1 =
  check (plotsReachable (parseFarm day21.inputs.example1) 6 === 16)

day21.solvePart1 : Text -> Nat
day21.solvePart1 text =
  farm = text |> parseFarm
  plotsReachable farm 64

day21.solvePart2Bad : Nat
day21.solvePart2Bad =
  use Farm bounds
  use Map get
  use Nat * + - / mod sum
  farm = parseFarm day21.inputs.puzzle
  neighbourWithCost =
    Farm.neighbours farm >> List.map (neighbour -> (neighbour, 1))
  farmBounds = bounds farm
  borderPointsByCompass = getBorderPointsForEachCompassDirection (bounds farm)
  shortestPathsByCompass =
    borderPointsByCompass |> Map.map (dijkstra neighbourWithCost)
  start = Farm.start farm
  mapWidth = width farmBounds
  stepsToNextMap = mapWidth |> (n -> n / 2 + 1)
  numReachablePlotsInCompleteMap =
    dijkstra neighbourWithCost start |> countReachable elfSteps
  countCardinal =
    stepsRemaining = elfSteps - stepsToNextMap
    wholeMultiples = stepsRemaining / mapWidth
    completeMaps = wholeMultiples
    stepsRemaining' = mod stepsRemaining mapWidth
    cardinalDirections
      |> List.map
           (direction ->
             completeMaps
               * numReachablePlotsInCompleteMap
               + countReachable
                 stepsRemaining'
                 (get direction shortestPathsByCompass |> getOrBug "Nah"))
      |> sum
  countOrdinal =
    stepsRemaining = elfSteps - stepsToNextMap * 2
    wholeMultiples = stepsRemaining / mapWidth
    completeMaps = triangularNumber wholeMultiples
    stepsRemaining' = mod stepsRemaining mapWidth
    ordinalDirections
      |> List.map
           (direction ->
             completeMaps
               * numReachablePlotsInCompleteMap
               + (wholeMultiples
                 + 1)
                 * countReachable
                   stepsRemaining'
                   (get direction shortestPathsByCompass |> getOrBug "Nah"))
      |> sum
  countCardinal + countOrdinal + numReachablePlotsInCompleteMap

day21.step : Farm -> Set Point -> Nat -> Set Point
day21.step farm points stepsLeft = match stepsLeft with
  0 -> points
  n ->
    use Nat -
    neighbours = points |> Set.flatMap (Farm.neighbours farm >> Set.fromList)
    day21.step farm neighbours (stepsLeft - 1)

