day14.parser.parseTerrain : Char -> day14.Terrain
day14.parser.parseTerrain = cases
  ?O -> RoundedRock
  ?# -> SquareShapedRock
  ?. -> EmptySpace
  _  -> bug "Unexpected character"

day14.parser.parseTerrainGrid : Text -> [[day14.Terrain]]
day14.parser.parseTerrainGrid =
  use List map
  lines >> map toCharList >> map (map day14.parser.parseTerrain)

day14.parser.parseTerrainLine : Text -> [day14.Terrain]
day14.parser.parseTerrainLine =
  toCharList >> List.map day14.parser.parseTerrain

day14.puzzle.solutionPart1 : Nat
day14.puzzle.solutionPart1 = day14.solvePart1 day14.inputs.puzzle

day14.puzzle.solutionPart2 : Nat
day14.puzzle.solutionPart2 = day14.solvePart2 day14.inputs.puzzle

day14.scoreTerrainGrid : [[day14.Terrain]] -> Nat
day14.scoreTerrainGrid lines =
  use Nat * +
  scoreLine = cases
    (line, index) ->
      (line |> List.count (terrain -> terrain === RoundedRock)) * (index + 1)
  lines |> List.reverse |> List.indexed |> Nat.sumBy scoreLine

day14.solvePart1 : Text -> Nat
day14.solvePart1 =
  parseTerrainGrid >> transpose >> tiltGrid >> transpose >> scoreTerrainGrid

test> day14.solvePart1.tests.example1 =
  check (day14.solvePart1 day14.inputs.example1 === 136)

test> day14.solvePart1.tests.puzzle =
  check (day14.solvePart1 day14.inputs.puzzle === 110677)

day14.solvePart2 : Text -> Nat
day14.solvePart2 = applyWithEmptyStore solvePart2'

test> day14.solvePart2.tests.example1 =
  check (day14.solvePart2 day14.inputs.example1 === 64)

test> day14.solvePart2.tests.puzzle =
  check (day14.solvePart2 day14.inputs.puzzle === 90551)

day14.solvePart2' :
  Text ->{Store (Map [[day14.Terrain]] [[day14.Terrain]])} Nat
day14.solvePart2' text =
  use Nat + -
  grid = parseTerrainGrid text
  (Cycle period offset) = findCycle spinCycleMemoised grid
  iterations = offset + Nat.mod (1000000000 - offset) period
  iterateNTimes iterations spinCycleMemoised grid |> scoreTerrainGrid

day14.spinCycle : [[day14.Terrain]] -> [[day14.Terrain]]
day14.spinCycle grid =
  use List map reverse
  grid
    |> (transpose >> tiltGrid >> transpose)
    |> tiltGrid
    |> (reverse >> transpose >> tiltGrid >> transpose >> reverse)
    |> (map reverse >> tiltGrid >> map reverse)

test> day14.spinCycle.tests.example1AfterOneCycle =
  check
    ((parseTerrainGrid day14.inputs.example1 |> spinCycle |> terrainGridToText)
      === ".....#....\n....#...O#\n...OO##...\n.OO#......\n.....OOO#.\n.O#...O#.#\n....O#....\n......OOOO\n#...O###..\n#..OO#....")

test> day14.spinCycle.tests.example1AfterThreeCycles =
  check
    ((parseTerrainGrid day14.inputs.example1
      |> spinCycle
      |> spinCycle
      |> spinCycle
      |> terrainGridToText)
      === ".....#....\n....#...O#\n.....##...\n..O#......\n.....OOO#.\n.O#...O#.#\n....O#...O\n.......OOO\n#...O###.O\n#.OOO#...O")

test> day14.spinCycle.tests.example1AfterTwoCycles =
  check
    ((parseTerrainGrid day14.inputs.example1
      |> spinCycle
      |> spinCycle
      |> terrainGridToText)
      === ".....#....\n....#...O#\n.....##...\n..O#......\n.....OOO#.\n.O#...O#.#\n....O#...O\n.......OOO\n#..OO###..\n#.OOO#...O")

day14.spinCycleMemoised :
  [[day14.Terrain]]
  ->{Store (Map [[day14.Terrain]] [[day14.Terrain]])} [[day14.Terrain]]
day14.spinCycleMemoised grid = getOrUpdate grid do spinCycle grid

day14.terrainGridToText : [[day14.Terrain]] -> Text
day14.terrainGridToText = List.map terrainLineToText >> Text.join "\n"

day14.terrainLineToText : [day14.Terrain] -> Text
day14.terrainLineToText = List.map terrainToText >> Text.join ""

day14.terrainToText : day14.Terrain -> Text
day14.terrainToText = cases
  RoundedRock      -> "O"
  SquareShapedRock -> "#"
  EmptySpace       -> "."

day14.tiltGrid : [[day14.Terrain]] -> [[day14.Terrain]]
day14.tiltGrid = List.map tiltLine

day14.tiltLine : [day14.Terrain] -> [day14.Terrain]
day14.tiltLine positions =
  use List ++ span
  if List.isEmpty positions then []
  else
    (roundedAndEmpty, rest) =
      span
        (terrain -> terrain === RoundedRock || terrain === EmptySpace)
        positions
    (squareRocks, rest') = span (terrain -> terrain === SquareShapedRock) rest
    (roundedRocks, empty) =
      List.partition (terrain -> terrain === RoundedRock) roundedAndEmpty
    roundedRocks ++ empty ++ squareRocks ++ day14.tiltLine rest'

test> day14.tiltLine.tests.example1 =
  check
    ((parseTerrainLine "O.O.O.#.O###." |> tiltLine |> terrainLineToText)
      === "OOO...#O.###.")

day15.handleStep : Step ->{Store (Map Nat [Lens])} ()
day15.handleStep = cases
  Remove label             ->
    boxNumber = day15.hash label
    Store.modify (modifyBox boxNumber (removeLensFromBox label))
  Upsert label focusLength ->
    boxNumber = day15.hash label
    lens = Lens label focusLength
    Store.modify (modifyBox boxNumber (upsertLensInBox lens))

day15.hash : Text -> Nat
day15.hash text =
  use Nat * +
  text
    |> toCharList
    |> List.map Char.toNat
    |> List.foldLeft (n c -> Nat.mod ((n + c) * 17) 256) 0

test> day15.hash.tests.case1 = check (day15.hash "HASH" === 52)

day15.inputs.example1 : Text
day15.inputs.example1 = "rn=1,cm-,qp=3,cm=2,qp-,pc=4,ot=9,ab=5,pc-,pc=6,ot=7"

