  check
    (Parse.run parser.times "Time:      7  15   30"
      === Either.Right [7, 15, 30])

day06.parser.timesheet : '{Parse e} Timesheet
day06.parser.timesheet = do
  times = lineOfTimes "Time:"
  distances = lineOfTimes "Distance:"
  Timesheet times distances

test> day06.parser.timesheet.tests.example =
  check
    (Parse.run timesheet day06.example
      === Either.Right (Timesheet [7, 15, 30] [9, 40, 200]))

day06.puzzle.input : Text
day06.puzzle.input =
  """
  Time:        60     94     78     82
  Distance:   475   2138   1015   1650
  """

day06.puzzle.solutionPart1 : Nat
day06.puzzle.solutionPart1 = day06.solvePart1 day06.puzzle.input

day06.puzzle.solutionPart2 : Nat
day06.puzzle.solutionPart2 = day06.solvePart2 day06.puzzle.input

day06.reparse : Timesheet -> Race
day06.reparse = cases
  Timesheet times distances ->
    recombineDigits : [Nat] -> Nat
    recombineDigits digits =
      digits
        |> List.map Nat.toText
        |> Text.join ""
        |> Nat.fromText
        |> getOrBug "bad digits"
    Race (recombineDigits times) (recombineDigits distances)

day06.solvePart1 : Text -> Nat
day06.solvePart1 input =
  timesheet = utils.parseOrBug parser.timesheet input
  races = getRaces timesheet
  races |> List.map waysToWin |> Nat.product

test> day06.solvePart1.tests.example =
  check (day06.solvePart1 day06.example === 288)

test> day06.solvePart1.tests.puzzle =
  check (day06.solvePart1 day06.puzzle.input === 345015)

day06.solvePart2 : Text -> Nat
day06.solvePart2 input =
  timesheet = utils.parseOrBug parser.timesheet input
  race = reparse timesheet
  waysToWin race

test> day06.solvePart2.tests.example =
  check (day06.solvePart2 day06.example === 71503)

test> day06.solvePart2.tests.puzzle =
  check (day06.solvePart2 day06.puzzle.input === 42588603)

day06.waysToWin : Race -> Nat
day06.waysToWin race =
  use Nat + -
  (low, high) = buttonTimes race
  newLow =
    if distanceTravelled (raceDuration race) low === recordDistance race then
      low + 1
    else low
  newHigh =
    if distanceTravelled (raceDuration race) high === recordDistance race then
      high - 1
    else high
  newHigh - newLow + 1

test> day06.waysToWin.tests.example1 = check (waysToWin (Race 7 9) === 4)

test> day06.waysToWin.tests.example2 = check (waysToWin (Race 15 40) === 8)

test> day06.waysToWin.tests.example3 = check (waysToWin (Race 30 200) === 9)

day07.allCards : [Nat]
day07.allCards =
  use Nat +
  Nat.range 2 (14 + 1)

day07.allCardsExceptJoker : [Nat]
day07.allCardsExceptJoker =
  use Nat !=
  allCards |> List.filter (card -> card != joker)

day07.Card.joker : Nat
day07.Card.joker = 11

day07.Card.toText : Nat -> Text
day07.Card.toText = cases
  14 -> "A"
  13 -> "K"
  12 -> "Q"
  11 -> "J"
  10 -> "T"
  9  -> "9"
  8  -> "8"
  7  -> "7"
  6  -> "6"
  5  -> "5"
  4  -> "4"
  3  -> "3"
  2  -> "2"
  _  -> bug "invalid card"

day07.classifyHand : Hand -> HandType
day07.classifyHand hand = match signature hand with
  [5]    -> FiveOfAKind
  [4]    -> FourOfAKind
  [3, 2] -> FullHouse
  [3]    -> ThreeOfAKind
  [2, 2] -> TwoPair
  [2]    -> OnePair
  _      -> HighCard

test> day07.classifyHand.tests.fiveOfAKind =
  check (classifyHand (utils.parseOrBug parser.hand "AAAAA") === FiveOfAKind)

test> day07.classifyHand.tests.fourOfAKind =
  check (classifyHand (utils.parseOrBug parser.hand "AA8AA") === FourOfAKind)

test> day07.classifyHand.tests.fullHouse =
  check (classifyHand (utils.parseOrBug parser.hand "23332") === FullHouse)

test> day07.classifyHand.tests.highCard =
  check (classifyHand (utils.parseOrBug parser.hand "23456") === HighCard)

test> day07.classifyHand.tests.onePair =
  check (classifyHand (utils.parseOrBug parser.hand "A23A4") === OnePair)

test> day07.classifyHand.tests.threeOfAKind =
  check (classifyHand (utils.parseOrBug parser.hand "TTT98") === ThreeOfAKind)

test> day07.classifyHand.tests.twoPair =
  check (classifyHand (utils.parseOrBug parser.hand "23432") === TwoPair)

day07.classifyHand2 : Hand -> HandType
day07.classifyHand2 hand =
  use Nat >=
  cardBag = hand |> cards |> Bag.fromList
  cardBag
    |> Bag.count joker
    |> (cases
         n| n >= 4  -> FiveOfAKind
         _ ->
           getPossibleHandsByReplacingJokers hand
             |> List.map classifyHand
             |> maximumBy compareHandTypes
             |> getOrBug "no max hand")

test> day07.classifyHand2.tests.acesAndJoker =
  check (classifyHand2 (parseHand "AAAAJ") === FiveOfAKind)

test> day07.classifyHand2.tests.fiveOfAKind =
  check (classifyHand2 (utils.parseOrBug parser.hand "QJJQ2") === FourOfAKind)

test> day07.classifyHand2.tests.fiveOfAKindVariation1 =
  check (classifyHand2 (utils.parseOrBug parser.hand "JJJJJ") === FiveOfAKind)

test> day07.classifyHand2.tests.fullHouseJoker =
  check (classifyHand2 (parseHand "2233J") === FullHouse)

test> day07.classifyHand2.tests.onePair =
  check (classifyHand2 (utils.parseOrBug parser.hand "32T3K") === OnePair)

test> day07.classifyHand2.tests.threeOfAKindTwoJokers =
  check (classifyHand2 (parseHand "AJJ94") === ThreeOfAKind)

day07.classifyHand2Memoised : Hand ->{Store (Map Hand HandType)} HandType
day07.classifyHand2Memoised hand = getOrUpdate hand do classifyHand2 hand

day07.compareHandAndBids : HandAndBid -> HandAndBid -> Ordering
day07.compareHandAndBids handAndBid1 handAndBid2 =
  use HandAndBid hand
  compareHands (hand handAndBid1) (hand handAndBid2)

day07.compareHandAndBids2 :
  HandAndBid -> HandAndBid ->{Store (Map Hand HandType)} Ordering
day07.compareHandAndBids2 handAndBid1 handAndBid2 =
  use HandAndBid hand
  compareHands2 (hand handAndBid1) (hand handAndBid2)

day07.compareHands : Hand -> Hand -> Ordering
day07.compareHands hand1 hand2 =
  use Universal ordering
  Ordering.andThen
    (ordering
      (classifyHand hand1 |> handTypeStrength)
      (classifyHand hand2 |> handTypeStrength))
    (ordering hand1 hand2)

test> day07.compareHands.tests.equal =
  use parser hand
  use utils parseOrBug
  check
    (compareHands (parseOrBug hand "AKQJT") (parseOrBug hand "AKQJT")
      === Equal)

test> day07.compareHands.tests.fourOfAKindVsFourOfAKind =
  use parser hand
  use utils parseOrBug
  check
    (compareHands (parseOrBug hand "33332") (parseOrBug hand "2AAAA")
      === Greater)

test> day07.compareHands.tests.fullHouseVsFullHouse =
  use parser hand
  use utils parseOrBug
  check
    (compareHands (parseOrBug hand "77888") (parseOrBug hand "77788")
      === Greater)

test> day07.compareHands.tests.strongestHandTypeWins =
  use parser hand
  use utils parseOrBug
  check
    (compareHands (parseOrBug hand "AA8AA") (parseOrBug hand "A23A4")
      === Greater)

day07.compareHands2 : Hand -> Hand ->{Store (Map Hand HandType)} Ordering
day07.compareHands2 hand1 hand2 =
  use Universal ordering
  Ordering.andThen
    (ordering
      (classifyHand2Memoised hand1 |> handTypeStrength)
      (classifyHand2Memoised hand2 |> handTypeStrength))
    (ordering (weakenJacks hand1) (weakenJacks hand2))

day07.compareHandTypes : HandType -> HandType -> Ordering
day07.compareHandTypes handType1 handType2 =
  Universal.ordering (handTypeStrength handType1) (handTypeStrength handType2)

day07.example : Text
day07.example =
  """
  32T3K 765
  T55J5 684
  KK677 28
  KTJJT 220
  QQQJA 483
  """

day07.firstCard : Hand -> Nat
day07.firstCard = cases
  Hand cards -> cards |> List.head |> getOrBug "empty hand"

day07.getPossibleHandsByReplacingJokers : Hand -> [Hand]
day07.getPossibleHandsByReplacingJokers = cases
  Hand cards ->
    use List +: map
    use Nat ==
    allOptions : [Nat] -> [[Nat]]
    allOptions = cases
      [] -> [[]]
      card +: rest ->
        suffixes = allOptions rest
        if card == joker then
          allCards
            |> List.flatMap
              (substitutedCard -> map ((+:) substitutedCard) suffixes)
        else map ((+:) card) suffixes
    allOptions cards |> map Hand

day07.Hand.toText : Hand -> Text
day07.Hand.toText = cases
  Hand cards -> cards |> List.map Card.toText |> Text.join ""

day07.handTypeStrength : HandType -> Nat
day07.handTypeStrength = cases
  FiveOfAKind  -> 7
  FourOfAKind  -> 6
  FullHouse    -> 5
  ThreeOfAKind -> 4
  TwoPair      -> 3
  OnePair      -> 2
  HighCard     -> 1

test> day07.handTypeStrength.tests.fullHouseVsThreeOfAKind =
  use Nat >
  check (handTypeStrength FullHouse > handTypeStrength ThreeOfAKind)

