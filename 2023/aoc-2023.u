day19.parser.comparison : '{Parse e} Comparison
day19.parser.comparison =
  use Parse text
  lessThan = text "<" $> LessThan
  greaterThan = text ">" $> GreaterThan
  ors (lessThan +| [greaterThan])

day19.parser.conclusion : '{Parse e} Conclusion
day19.parser.conclusion =
  use Parse text
  accept = text "A" $> Accept
  reject = text "R" $> Reject
  sendToWorkflow : '{Parse e} Conclusion
  sendToWorkflow = do takeAlphanum1() |> SendToWorkflow
  ors (accept +| [reject, sendToWorkflow])

day19.parser.condition : '{Parse e} Condition
day19.parser.condition = do
  propertyName = takeAlphanum1()
  comparison = parser.comparison()
  value = numeric()
  Condition propertyName comparison value

day19.parser.parsePuzzleInput : Text -> day19.PuzzleInput
day19.parser.parsePuzzleInput text = match splitAll "\n\n" text with
  [workflowsText, partsText] ->
    use List map
    use utils parseOrBug
    workflows = workflowsText |> lines |> map (parseOrBug workflow)
    parts = partsText |> lines |> map (parseOrBug part)
    day19.PuzzleInput.PuzzleInput workflows parts
  _                          -> bug "invalid puzzle input"

test> day19.parser.parserPuzzleInput.tests.example1PartCount =
  use Nat ==
  check
    ((day19.inputs.example1
      |> day19.parser.parsePuzzleInput
      |> parts
      |> List.size)
      == 5)

test> day19.parser.parserPuzzleInput.tests.example1WorkflowCount =
  use Nat ==
  check
    ((day19.inputs.example1
      |> day19.parser.parsePuzzleInput
      |> workflows
      |> List.size)
      == 11)

day19.parser.part : '{Parse e} Map Text Nat
day19.parser.part = do
  text! "{"
  properties = sep1! (Parse.text ",") property
  text! "}"
  properties |> Map.unions

day19.parser.property : '{Parse e} Map Text Nat
day19.parser.property = do
  propertyName = takeAlphanum1()
  text! "="
  value = numeric()
  Map.singleton propertyName value

day19.parser.rule : '{Parse e} Rule
day19.parser.rule = do
  condition = parser.condition()
  text! ":"
  conclusion = parser.conclusion()
  Rule condition conclusion

test> day19.parser.rule.tests.example =
  check
    (utils.parseOrBug rule "x>10:one"
      === Rule (Condition "x" GreaterThan 10) (SendToWorkflow "one"))

test> day19.parser.rule.tests.example2 =
  check
    (utils.parseOrBug rule "m<20:two"
      === Rule (Condition "m" LessThan 20) (SendToWorkflow "two"))

test> day19.parser.rule.tests.example3 =
  check
    (utils.parseOrBug rule "a>30:R"
      === Rule (Condition "a" GreaterThan 30) Reject)

day19.parser.workflow : '{Parse e} Workflow
day19.parser.workflow = do
  name = takeAlphanum1()
  text! "{"
  rules = endBy1! (Parse.text ",") (atomic rule)
  otherwise = parser.conclusion()
  text! "}"
  Workflow name rules otherwise

test> day19.parser.workflow.tests.example =
  check
    (utils.parseOrBug workflow "ex{x>10:one,m<20:two,a>30:R,A}"
      === Workflow
        "ex"
        [ Rule (Condition "x" GreaterThan 10) (SendToWorkflow "one")
        , Rule (Condition "m" LessThan 20) (SendToWorkflow "two")
        , Rule (Condition "a" GreaterThan 30) Reject
        ]
        Accept)

day19.partRangeSize : Map Text NatRange -> Nat
day19.partRangeSize partRange =
  Map.values partRange |> List.map NatRange.length |> Nat.product

day19.ratingNumber : Map Text Nat -> Nat
day19.ratingNumber = Map.values >> Nat.sum

test> day19.ratingNumber.tests.example1 =
  use Nat ==
  check
    (("{x=787,m=2655,a=1222,s=2876}" |> utils.parseOrBug part |> ratingNumber)
      == 7540)

day19.runRule : Rule -> Map Text Nat -> Optional Conclusion
day19.runRule rule part =
  use Nat < >
  (Rule condition conclusion) = rule
  (Condition propertyName comparison value) = condition
  propertyValue = Map.get propertyName part |> getOrBug "invalid property name"
  match comparison with
    LessThan    -> if propertyValue < value then Some conclusion else None
    GreaterThan -> if propertyValue > value then Some conclusion else None

day19.runRuleOnPartRange :
  Rule -> Map Text NatRange ->{Each} (Map Text NatRange, Optional Conclusion)
day19.runRuleOnPartRange rule partRange =
  (Rule condition conclusion) = rule
  (satisfies, doesNotSatisfy) = splitOnCondition condition partRange
  each [(satisfies, Some conclusion), (doesNotSatisfy, None)]
    |> Tuple.mapLeft optionally

day19.runWorkflow : Workflow -> Map Text Nat -> Conclusion
day19.runWorkflow workflow part =
  (Workflow name rules otherwise) = workflow
  go : [Rule] -> Conclusion
  go = cases
    rule +: rest -> runRule rule part |> (getOrElse' do go rest)
    []           -> otherwise
  go rules

day19.runWorkflowOnPartRange :
  Workflow -> Map Text NatRange ->{Each} (Map Text NatRange, Conclusion)
day19.runWorkflowOnPartRange workflow partRange =
  (Workflow name rules otherwise) = workflow
  go : [Rule] -> Map Text NatRange ->{Each} (Map Text NatRange, Conclusion)
  go rules partRange = match rules with
    rule +: rest ->
      (childRange, maybeConclusion) = runRuleOnPartRange rule partRange
      match maybeConclusion with
        None            -> go rest childRange
        Some conclusion -> (childRange, conclusion)
    []           -> (partRange, otherwise)
  go rules partRange

day19.solvePart1 : Text -> Nat
day19.solvePart1 text =
  (day19.PuzzleInput.PuzzleInput workflows parts) =
    text |> day19.parser.parsePuzzleInput
  workflowsByName = workflows |> indexWorkflowsByName
  isAccepted : Text -> Map Text Nat -> Boolean
  isAccepted workflowName part =
    workflow =
      workflowsByName
        |> Map.get workflowName
        |> getOrBug "invalid workflow name"
    match runWorkflow workflow part with
      Accept                      -> true
      Reject                      -> false
      SendToWorkflow workflowName -> isAccepted workflowName part
  parts |> List.filter (isAccepted "in") |> Nat.sumBy ratingNumber

test> day19.solvePart1.tests.example =
  check (day19.solvePart1 day19.inputs.example1 === 19114)

day19.solvePart2 : Text -> Nat
day19.solvePart2 text =
  use List map
  (day19.PuzzleInput.PuzzleInput workflows parts) =
    text |> day19.parser.parsePuzzleInput
  workflowsByName = workflows |> indexWorkflowsByName
  processRangeThroughWorkflow :
    Text -> Map Text NatRange ->{Each} Map Text NatRange
  processRangeThroughWorkflow workflowName partRange =
    workflow =
      workflowsByName
        |> Map.get workflowName
        |> getOrBug "invalid workflow name"
    match runWorkflowOnPartRange workflow partRange with
      (childPartRange, Accept) -> childPartRange
      (childPartRange, Reject) -> Each.fail()
      (childPartRange, SendToWorkflow workflowName) ->
        processRangeThroughWorkflow workflowName childPartRange
  entireRange =
    "xmas"
      |> toCharList
      |> map Char.toText
      |> map (propertyName -> (propertyName, NatRange.fromToInclusive 1 4000))
      |> Map.fromList
  (Each.toList do processRangeThroughWorkflow "in" entireRange)
    |> Nat.sumBy partRangeSize

test> day19.solvePart2.tests.example1 =
  check (day19.solvePart2 day19.inputs.example1 === 167409079868000)

test> day19.solvePart2.tests.puzzle =
  check (day19.solvePart2 day19.inputs.puzzle === 124615747767410)

day19.splitOnCondition :
  Condition
  -> Map Text NatRange
  -> (Optional (Map Text NatRange), Optional (Map Text NatRange))
day19.splitOnCondition condition partRange =
  use Map insert
  use Optional map
  name = condition |> propertyName
  propertyRange = Map.get name partRange |> getOrBug "invalid property name"
  (rangeWhichSatisfiesCondition, rangeWhichDoesNotSatisfyCondition) =
    splitRangeOnCondition condition propertyRange
  ( rangeWhichSatisfiesCondition |> map (range -> insert name range partRange)
  , rangeWhichDoesNotSatisfyCondition
      |> map (range -> insert name range partRange)
  )

day19.splitRangeGreaterThan :
  Nat -> NatRange -> (Optional NatRange, Optional NatRange)
day19.splitRangeGreaterThan value range =
  use Nat + < >=
  use NatRange fromToInclusive
  (NatRange start length) = range
  end = NatRange.endInclusive range
  if value < start then (Some range, None)
  else
    if value >= end then (None, Some range)
    else
      ( Some (fromToInclusive (value + 1) end)
      , Some (fromToInclusive start value)
      )

test> day19.splitRangeGreaterThan.tests.allGreater =
  use NatRange fromToInclusive
  check
    (splitRangeGreaterThan 1 (fromToInclusive 2 7)
      === (Some (fromToInclusive 2 7), None))

test> day19.splitRangeGreaterThan.tests.middle =
  use NatRange fromToInclusive
  check
    (splitRangeGreaterThan 5 (fromToInclusive 2 7)
      === (Some (fromToInclusive 6 7), Some (fromToInclusive 2 5)))

test> day19.splitRangeGreaterThan.tests.noGreater =
  use NatRange fromToInclusive
  check
    (splitRangeGreaterThan 7 (fromToInclusive 2 7)
      === (None, Some (fromToInclusive 2 7)))

day19.splitRangeLessThan :
  Nat -> NatRange -> (Optional NatRange, Optional NatRange)
day19.splitRangeLessThan value range =
  use Nat + - <= >=
  (NatRange start length) = range
  if start >= value then (None, Some range)
  else
    if start + length <= value then (Some range, None)
    else
      ( Some (NatRange.fromToInclusive start (value - 1))
      , Some (NatRange value (length + start - value))
      )

test> day19.splitRangeLessThan.tests.middle =
  use NatRange fromToInclusive
  check
    (splitRangeLessThan 5 (fromToInclusive 2 7)
      === (Some (fromToInclusive 2 4), Some (fromToInclusive 5 7)))

test> day19.splitRangeLessThan.tests.noGreater =
  use NatRange fromToInclusive
  check
    (splitRangeLessThan 8 (fromToInclusive 2 7)
      === (Some (fromToInclusive 2 7), None))

test> day19.splitRangeLessThan.tests.noSmaller =
  use NatRange fromToInclusive
  check
    (splitRangeLessThan 2 (fromToInclusive 2 7)
      === (None, Some (fromToInclusive 2 7)))

day19.splitRangeOnCondition :
  Condition -> NatRange -> (Optional NatRange, Optional NatRange)
day19.splitRangeOnCondition condition range =
  (Condition propertyName comparison value) = condition
  match comparison with
    LessThan    -> splitRangeLessThan value range
    GreaterThan -> splitRangeGreaterThan value range

day20.addUntypedModules : ModuleNetwork -> ModuleNetwork
day20.addUntypedModules network =
  use Map keys
  use Set fromList
  typedModuleNames = network |> connectivity |> keys |> fromList
  allDestinationModuleNames =
    network |> connectivity |> invertMultimap |> keys |> fromList
  untypedModules =
    Set.difference allDestinationModuleNames typedModuleNames
      |> Set.toList
      |> List.map Module.Untyped
  network |> modules.modify (Map.union (untypedModules |> indexBy Module.name))

day20.initialiseConjunction : ModuleNetwork -> ModuleNetwork
day20.initialiseConjunction network =
  incomingMap = network |> connectivity |> invertMultimap
  initialiseModule : Module -> Module
  initialiseModule = cases
    conjunction@(Conjunction name _ destinations) ->
      inputs = Multimap.lookup name incomingMap
      mostRecentPulses =
        Map.fromList (inputs |> List.map (name -> (name, Low)))
      Conjunction name mostRecentPulses destinations
    module -> module
  network |> modules.modify (Map.map initialiseModule)

day20.inputs.example1 : Text
day20.inputs.example1 =
  """
  broadcaster -> a, b, c
  %a -> b
  %b -> c
  %c -> inv
  &inv -> a
  """

