day07.parser.characterToCard : Text -> Optional Nat
day07.parser.characterToCard = cases
  "A" -> Some 14
  "K" -> Some 13
  "Q" -> Some 12
  "J" -> Some 11
  "T" -> Some 10
  "9" -> Some 9
  "8" -> Some 8
  "7" -> Some 7
  "6" -> Some 6
  "5" -> Some 5
  "4" -> Some 4
  "3" -> Some 3
  "2" -> Some 2
  _   -> None

day07.parser.hand : '{Parse e} Hand
day07.parser.hand = do count! 5 day07.parser.card |> Hand

