  Card 5: 87 83 26 28 32 | 88 30 70 12 93 22 82 36
  Card 6: 31 18 13 56 72 | 74 77 10 23 35 67 36 11
  """

day04.parser.card : '{Parse e} day04.Card
day04.parser.card = do
  use day04.parser numberMaybeWhitespace
  text! "Card"
  skipWhitespace()
  cardNumber = numeric()
  text! ":"
  skipWhitespace()
  winningNumbers = many! numberMaybeWhitespace
  text! "|"
  skipWhitespace()
  numbersYouHave = many! numberMaybeWhitespace
  day04.Card.Card cardNumber winningNumbers numbersYouHave

