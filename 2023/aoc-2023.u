day17.puzzle.timePart1 : '{IO, Exception} (Nat, Text)
day17.puzzle.timePart1 = 
  measureTimeTaken do day17.solvePart1 day17.inputs.puzzle

day17.puzzle.timePart2 : '{IO, Exception} (Nat, Text)
day17.puzzle.timePart2 = 
  measureTimeTaken do day17.solvePart2 day17.inputs.puzzle

day17.SearchNode.neighbours :
  IntRange -> Rectangle -> SearchNode -> [SearchNode]
day17.SearchNode.neighbours consecutiveMoveRange bounds node =
  Direction.all
    |> List.filterMap
         (direction -> tryMove consecutiveMoveRange direction node)
    |> (List.filter cases
         SearchNode location _ -> Rectangle.contains bounds location)

day17.SearchNode.tryMove :
  IntRange -> utils.Direction -> SearchNode -> Optional SearchNode
day17.SearchNode.tryMove consecutiveMoveRange direction = cases
  SearchNode location history ->
    use Nat + < >= fromInt
    newLocation = Point.move direction 1 location
    newHistory =
      match history with
        None -> Some (direction, 1)
        Some (previousDirection, consecutiveSteps) ->
          if previousDirection === Direction.opposite direction then None
          else
            if previousDirection === direction then
              maxConsecutiveSteps =
                consecutiveMoveRange
                  |> IntRange.endInclusive
                  |> fromInt
                  |> getOrBug "bad consecutiveMoveRange"
              if consecutiveSteps >= maxConsecutiveSteps then None
              else Some (direction, consecutiveSteps + 1)
            else
              minConsecutiveSteps =
                consecutiveMoveRange
                  |> IntRange.start
                  |> fromInt
                  |> getOrBug "bad consecutiveMoveRange"
              if consecutiveSteps < minConsecutiveSteps then None
              else Some (direction, 1)
    newHistory |> Optional.map (Some >> SearchNode newLocation)

test> day17.SearchNode.tryMove.tests.canTurnIfLongEnough =
  check
    (tryMove
      (IntRange.fromToInclusive +4 +10)
      Down
      (SearchNode (Point 1 1) (Some (utils.Direction.Right, 4)))
      === Some (SearchNode (Point 1 2) (Some (Down, 1))))

test> day17.SearchNode.tryMove.tests.historyThreeStepsContinue =
  use utils.Direction Right
  check
    (tryMove (IntRange +1 +3) Right (SearchNode (Point 1 1) (Some (Right, 3)))
      === None)

test> day17.SearchNode.tryMove.tests.historyThreeStepsTurn =
  check
    (tryMove
      (IntRange +1 +3)
      Down
      (SearchNode (Point 1 1) (Some (utils.Direction.Right, 3)))
      === Some (SearchNode (Point 1 2) (Some (Down, 1))))

test> day17.SearchNode.tryMove.tests.historyTwoSteps =
  use utils.Direction Right
  check
    (tryMove (IntRange +1 +3) Right (SearchNode (Point 1 1) (Some (Right, 2)))
      === Some (SearchNode (Point 2 1) (Some (Right, 3))))

test> day17.SearchNode.tryMove.tests.noAboutFace =
  check
    (tryMove
      (IntRange +1 +3)
      utils.Direction.Right
      (SearchNode (Point 1 1) (Some (utils.Direction.Left, 1)))
      === None)

test> day17.SearchNode.tryMove.tests.noHistory =
  use utils.Direction Right
  check
    (tryMove (IntRange +1 +3) Right (SearchNode (Point 1 1) None)
      === Some (SearchNode (Point 2 1) (Some (Right, 1))))

test> day17.SearchNode.tryMove.tests.noTurnIfTooShort =
  check
    (tryMove
      (IntRange.fromToInclusive +4 +10)
      Down
      (SearchNode (Point 1 1) (Some (utils.Direction.Right, 3)))
      === None)

day17.solve : IntRange -> Text -> Nat
day17.solve consecutiveMoveRange text =
  use List at map
  use Nat -
  grid = text |> textToCharArray2D
  (gridWidth, gridHeight) = gridWidthAndHeight grid
  bounds = Rectangle (Point 1 1) (Point gridWidth gridHeight)
  heatLossIncurred : Point -> Nat
  heatLossIncurred = cases
    Point x y ->
      grid
        |> at (y - 1)
        |> getOrBug "invalid grid"
        |> at (x - 1)
        |> getOrBug "invalid grid"
        |> digitCharToNatValue
  adjacency : SearchNode -> [(SearchNode, Nat)]
  adjacency node =
    SearchNode.neighbours consecutiveMoveRange bounds node
      |> map
        (neighbour ->
          (neighbour, heatLossIncurred (SearchNode.location neighbour)))
  initialNode = SearchNode (bounds |> Rectangle.topLeft) None
  distancesToNodes = dijkstra adjacency initialNode
  isValidFinishNode : SearchNode -> Boolean
  isValidFinishNode = cases
    SearchNode node history ->
      node === bottomRight bounds
        && (history
          |> (Optional.exists cases
            (direction, consecutiveSteps) ->
              consecutiveSteps
                |> Nat.toInt
                |> IntRange.contains consecutiveMoveRange))
  distancesToNodes
    |> Map.toList
    |> List.filter (at1 >> isValidFinishNode)
    |> map at2
    |> minimum
    |> getOrBug "no minimum"

day17.solvePart1 : Text -> Nat
day17.solvePart1 text = solve (IntRange.fromToInclusive +1 +3) text

test> day17.solvePart1.tests.example1 =
  check (day17.solvePart1 day17.inputs.example1 === 102)

day17.solvePart2 : Text -> Nat
day17.solvePart2 text = solve (IntRange.fromToInclusive +4 +10) text

test> day17.solvePart2.tests.example1 =
  check (day17.solvePart2 day17.inputs.example1 === 94)

test> day17.solvePart2.tests.example2 =
  check (day17.solvePart2 day17.inputs.example2 === 71)

day18.beforeAndAfterTriples : [a] -> [(a, a, a)]
day18.beforeAndAfterTriples xs =
  use List zip
  zip (zip (utils.rotateRight xs) xs) (utils.rotateLeft xs)
    |> (List.map cases ((before, current), after) -> (before, current, after))

test> day18.beforeAndAfterTriples.tests.example =
  check
    (beforeAndAfterTriples [1, 2, 3, 4]
      === [(4, 1, 2), (1, 2, 3), (2, 3, 4), (3, 4, 1)])

day18.DigPlanInstruction.isRight : DigPlanInstruction -> Boolean
day18.DigPlanInstruction.isRight = cases
  DigPlanInstruction direction _ _ -> direction === utils.Direction.Right

day18.digTrenchBoundary : Point -> [DigPlanInstruction] -> Set Point
day18.digTrenchBoundary current = cases
  [] -> Set.empty
  DigPlanInstruction direction steps _ +: rest ->
    use Point move
    newPoints =
      Nat.rangeClosed 1 steps
        |> List.map (n -> move direction n current)
        |> Set.fromList
    newCurrent = move direction steps current
    newPoints |> Set.union (day18.digTrenchBoundary newCurrent rest)

day18.floodFill : Point -> Set Point -> Set Point
day18.floodFill start boundary =
  go : Set Point -> Set Point -> Set Point
  go visited frontier =
    if data.Set.isEmpty frontier then visited
    else
      newFrontier =
        frontier
          |> Set.filter (p -> Boolean.not (Set.contains p visited))
          |> Set.flatMap (p -> Point.neighbours p |> Set.fromList)
      go (Set.union visited frontier) newFrontier
  go boundary (Set.singleton start)

day18.floodFillStartPoint : [DigPlanInstruction] -> Point
day18.floodFillStartPoint = cases
  DigPlanInstruction direction1 steps _ +: (DigPlanInstruction direction2 _ _ +: _) ->
    use Point move
    firstTurn = move direction1 steps day18.origin
    firstTurn |> move (Direction.opposite direction1) 1 |> move direction2 1
  _ -> bug "invalid instructions"

day18.getTurn : utils.Direction -> utils.Direction -> Turn
day18.getTurn oldDirection newDirection =
  match (oldDirection, newDirection) with
    (Up, utils.Direction.Right)   -> TurnRight
    (Up, utils.Direction.Left)    -> TurnLeft
    (Down, utils.Direction.Right) -> TurnLeft
    (Down, utils.Direction.Left)  -> TurnRight
    (utils.Direction.Left, Up)    -> TurnRight
    (utils.Direction.Left, Down)  -> TurnLeft
    (utils.Direction.Right, Up)   -> TurnLeft
    (utils.Direction.Right, Down) -> TurnRight
    _                             -> bug "invalid turn"

