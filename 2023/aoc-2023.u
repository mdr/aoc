day20.slidingDiff2Pairwise : [(Nat, Nat)] -> [(Nat, Nat)]
day20.slidingDiff2Pairwise = cases
  [] -> []
  (a, b) +: [] -> []
  (a, b) +: ((c, d) +: rest) ->
    (c Nat.- a, d Nat.- b)
      List.+: day20.slidingDiff2Pairwise ((c, d) List.+: rest)

test> day20.slidingDiff2Pairwise.tests.example =
  check
    (slidingDiff2Pairwise [(1, 2), (3, 4), (5, 6), (7, 8)]
      === [(2, 2), (2, 2), (2, 2)])

day20.solutionPart2 : Nat
day20.solutionPart2 = lcmAll [3917, 3769, 4013, 3889]

day20.solvePart1 : Text -> Nat
day20.solvePart1 text =
  network = text |> parseAndInitialise
  totalPulseCounts = 
    withInitialValueReturningStore zeros do
      iterateNTimes 1000 pressButton network
  score totalPulseCounts

test> day20.solvePart1.tests.example1 =
  check (day20.solvePart1 day20.inputs.example1 === 32000000)

test> day20.solvePart1.tests.example2 =
  check (day20.solvePart1 day20.inputs.example2 === 11687500)

test> day20.solvePart1.tests.puzzle =
  check (day20.solvePart1 day20.inputs.puzzle === 703315117)

day20.solvePart2 : Text -> Nat
day20.solvePart2 text =
  network = text |> parseAndInitialise
  todo!

day21.countReachable : Nat -> Map Point Nat -> Nat
day21.countReachable steps shortestPaths =
  use Nat >=
  Map.values shortestPaths
    |> List.count (n -> steps >= n && Nat.mod n 2 === elfStepArity)

day21.elfStepArity : Nat
day21.elfStepArity = Nat.mod elfSteps 2

day21.elfSteps : Nat
day21.elfSteps = 26501365

day21.Farm.lookup : Farm -> Point -> Optional day21.Terrain
day21.Farm.lookup farm point =
  (Farm grid bounds _) = farm
  if Rectangle.contains bounds point then
    grid.lookup grid (point |> moveLeft 1 |> moveUp 1)
  else None

day21.Farm.neighbours : Farm -> Point -> [Point]
day21.Farm.neighbours farm =
  Point.neighbours
    >> List.filter (neighbour -> Farm.lookup farm neighbour === Some Plot)

day21.getBorderPointsForEachCompassDirection :
  Rectangle -> Map CompassDirection8 Point
day21.getBorderPointsForEachCompassDirection = cases
  Rectangle topLeft bottomRight ->
    (Point left top) = topLeft
    (Point right bottom) = bottomRight
    Map.fromList
      [ (Northwest, topLeft)
      , (Southeast, bottomRight)
      , (Northeast, Point right top)
      , (Southwest, Point left bottom)
      , (North, Point ((left Nat.+ right) Nat./ 2) top)
      , (South, Point ((left Nat.+ right) Nat./ 2) bottom)
      , (East, Point right ((top Nat.+ bottom) Nat./ 2))
      , (West, Point left ((top Nat.+ bottom) Nat./ 2))
      ]

