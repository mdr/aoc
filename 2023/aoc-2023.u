day07.parser.card : '{Parse e} Nat
day07.parser.card =
  do
    cardCharacters =
      "A" +| ["K", "Q", "J", "T", "9", "8", "7", "6", "5", "4", "3", "2"]
    char = ors (cardCharacters |> List.Nonempty.map Parse.token) ()
    characterToCard char |> getOrBug "invalid card"

