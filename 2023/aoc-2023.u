  """

day10.parser.getNeighbours : Point -> Char -> [Point]
day10.parser.getNeighbours point = cases
  ?| -> [up point, down point]
  ?- -> [Point.left point, Point.right point]
  ?L -> [up point, Point.right point]
  ?J -> [up point, Point.left point]
  ?7 -> [down point, Point.left point]
  ?F -> [down point, Point.right point]
  ?. -> []
  ?S -> [up point, down point, Point.left point, Point.right point]
  _  -> bug "Unknown char"

day10.parser.parseCharPoints : Text -> [(Point, Char)]
day10.parser.parseCharPoints text =
  use List indexed
  textLineToCharPoints : (Text, Nat) -> [(Point, Char)]
  textLineToCharPoints = cases
    (lineText, lineNumber) ->
      lineText
        |> toCharList
        |> indexed
        |> (List.map cases
             (char, charNumber) -> (Point charNumber lineNumber, char))
  text |> lines |> indexed |> List.flatMap textLineToCharPoints

day10.parser.parseDimensions : Text -> (Nat, Nat)
day10.parser.parseDimensions text =
  lines = text |> Text.lines
  width = lines |> List.head |> getOrBug "no lines" |> Text.size
  height = lines |> List.size
  (width, height)

day10.parser.parsePipeGraph : Text -> PipeGraph
day10.parser.parsePipeGraph text =
  use Char ==
  charPoints = parseCharPoints text
  start =
    charPoints
      |> (List.find cases (point, char) -> char == ?S)
      |> getOrBug "No start found"
      |> at1
  addNeighbours : Map Point [Point] -> (Point, Char) -> Map Point [Point]
  addNeighbours connectionMap = cases
    (point, char) -> insertAll point (getNeighbours point char) connectionMap
  connectionMap = List.foldLeft addNeighbours Map.empty charPoints
  PipeGraph start connectionMap

day10.pointsToleftEdge : Point -> [Point]
day10.pointsToleftEdge = cases
  Point x y -> Nat.range 0 x |> List.map (x -> Point x y)

day10.prettyPrintGrid : Text -> Text
day10.prettyPrintGrid text =
  use Text ++
  chars = text |> toCharList
  newChars =
    chars |> (List.map cases
      ?|  -> ?│
      ?-  -> ?─
      ?L  -> ?└
      ?J  -> ?┘
      ?7  -> ?┐
      ?F  -> ?┌
      ?.  -> ?\s
      ?S  -> ?┼
      ?\n -> ?\n
      c   -> bug ("Unknown char " ++ Char.toText c))
  newChars |> fromCharList

day10.puzzle.solutionPart1 : Nat
day10.puzzle.solutionPart1 = day10.solvePart1 day10.inputs.puzzle

test> day10.puzzle.solutionPart1.tests.puzzle =
  check (day10.puzzle.solutionPart1 === 6725)

day10.puzzle.solutionPart2 : Nat
day10.puzzle.solutionPart2 = day10.solvePart2 day10.inputs.puzzle

day10.removeNonLoopCharacters : Set Point -> Text -> Text
day10.removeNonLoopCharacters loopPoints text =
  use List indexed map
  processLine : (Text, Nat) -> Text
  processLine = cases
    (line, lineNumber) ->
      line |> toCharList |> indexed |> (map cases
        (char, charNumber) ->
          point = Point charNumber lineNumber
          if Set.contains point loopPoints then char else ?\s) |> fromCharList
  text |> lines |> indexed |> map processLine |> Text.join "\n"

day10.replaceCharacter : Text -> Point -> Char -> Text
day10.replaceCharacter text point char =
  (Point x y) = point
  lines = text |> Text.lines
  replaceInLine : Text -> Text
  replaceInLine line = line |> toCharList |> replace x char |> fromCharList
  modifyListAt y replaceInLine lines |> Text.join "\n"

day10.scanLine : '{LineScanner} ()
day10.scanLine _ = match nextCharacter with
  ?│  ->
    flipIsInsideLoop
    day10.scanLine()
  ?\s ->
    when isInsideLoop do emitPosition
    day10.scanLine()
  ?└  -> day10.scanLineFromL()
  ?┼  -> day10.scanLineFromL()
  ?┌  -> day10.scanLineFromF()
  c   -> bug ("Unexpected character 1: " Text.++ Char.toText c)

day10.scanLineFromF : '{LineScanner} ()
day10.scanLineFromF _ = match nextCharacter with
  ?─ -> day10.scanLineFromF()
  ?┐ -> day10.scanLine()
  ?┘ ->
    flipIsInsideLoop
    day10.scanLine()
  c  -> bug ("Unexpected character 3: " Text.++ Char.toText c)

day10.scanLineFromL : '{LineScanner} ()
day10.scanLineFromL _ = match nextCharacter with
  ?─ -> day10.scanLineFromL()
  ?┘ -> day10.scanLine()
  ?┐ ->
    flipIsInsideLoop
    day10.scanLine()
  c  -> bug ("Unexpected character 2: " Text.++ Char.toText c)

day10.solvePart1 : Text -> Nat
day10.solvePart1 =
  parsePipeGraph >> fixStartConnections >> getLoopLength >> halveRoundingUp

test> day10.solvePart1.tests.example1 =
  check (day10.solvePart1 day10.inputs.example1 === 4)

test> day10.solvePart1.tests.example2 =
  check (day10.solvePart1 day10.inputs.example2 === 8)

day10.solvePart2 : Text -> Nat
day10.solvePart2 text =
  (PipeGraph start connectionMap) =
    text |> parsePipeGraph |> fixStartConnections
  loopPoints = getLoopPoints text
  text' = prettyPrintGrid text |> removeNonLoopCharacters (getLoopPoints text)
  Debug.trace "text'" text'
  text' |> lines |> List.map getInnerPointsOnLine |> Nat.sumBy List.size

day11.containsNoGalaxies : [Char] -> Boolean
day11.containsNoGalaxies = List.contains ?# >> Boolean.not

day11.emptyGalaxyRowIndices : [[Char]] -> NatSet
day11.emptyGalaxyRowIndices =
  indicesWhere containsNoGalaxies >> NatSet.fromList

day11.expandUniverse : [[Char]] -> [[Char]]
day11.expandUniverse =
  expandUniverse1D >> transpose >> expandUniverse1D >> transpose

test> day11.expandUniverse.tests.example1 =
  expectedOutput =
    """
    ....#........
    .........#...
    #............
    .............
    .............
    ........#....
    .#...........
    ............#
    .............
    .............
    .........#...
    #....#.......
    """
  check
    ((day11.inputs.example1
      |> textToCharArray2D
      |> expandUniverse
      |> charArray2DToText)
      === expectedOutput)

day11.expandUniverse1D : [[Char]] -> [[Char]]
day11.expandUniverse1D =
  List.flatMap
    (line -> (if containsNoGalaxies line then [line, line] else [line]))

day11.findGalaxies : [[Char]] -> [Point]
day11.findGalaxies =
  use Char ==
  pointsWhere ((==) ?#)

