  Time:      7  15   30
  Distance:  9  40  200
  """

day06.getRaces : Timesheet -> [Race]
day06.getRaces = cases
  Timesheet times distances ->
    List.zipWith (time distance -> Race time distance) times distances

test> day06.getRaces.tests.example =
